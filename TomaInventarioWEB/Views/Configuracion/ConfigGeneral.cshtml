@{
    ViewBag.Title = "ConfigGeneral";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string nonce = (string)HttpContext.Current.Items["ScriptNonce"];
}

@*<p">Nonce vista: @nonce</p>*@


<link href="~/Assets/CSS/cdn/JqueryUI-1.13.2-themes.css" rel="stylesheet" />
<link href="~/Assets/CSS/cdn/croppie.css" rel="stylesheet" />


<a href="#SectionDatosEmpresa" id="link1"></a>
<a href="#SectionCorreoEmpresa" id="link2"></a>
<a href="#SectionImg" id="link3"></a>
<div class="accordion " id="accordionPanelsStayOpenExample">
    <div class="accordion-item accordion_block">
        <h2 class="accordion-header  ">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="true" aria-controls="panelsStayOpen-collapseOne" id="SectionDatosEmpresa">
                Datos de Empresa
            </button>
        </h2>
        <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse ">
            <div class="accordion-body">
                <div class="row">
                    <div class="col">
                        <div class="input-wrapper ">
                            <input type="text" class="input-text form-control" id="txt_nom_Empresa" autocomplete="off" maxlength="200">
                            <label for="txt_nom_Empresa" class="input-label">Nombre Empresa</label>
                        </div>
                    </div>
                    <div class="col">
                        <div class="input-wrapper ">
                            <input type="text" class="input-text form-control" id="txt_RUC" autocomplete="off" maxlength="20">
                            <label for="txt_RUC" class="input-label">RUC Empresa</label>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="input-wrapper ">
                            <input type="text" class="input-text form-control" id="txt_drc_Empresa" autocomplete="off" maxlength="100">
                            <label for="txt_drc_Empresa" class="input-label">Dirección Empresa</label>
                        </div>
                    </div>
                    <div class="col">
                        <div class="input-wrapper ">
                            <input type="text" class="input-text form-control" id="txt_tlf" autocomplete="off" maxlength="20">
                            <label for="txt_tlf" class="input-label">Teléfono Empresa</label>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="input-wrapper ">
                            <input type="text" class="input-text form-control" id="txt_rz_social" autocomplete="off" maxlength="100">
                            <label for="txt_rz_social" class="input-label">Razón Social</label>
                        </div>
                    </div>
                    <div class="col">
                        <button class="btn btn-success btn-lg float-end" id="btn_Save_DatosEmpresa">Guardar <i class="fa-solid fa-upload"></i></button>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="accordion-item accordion_block">
        <h2 class="accordion-header">
            <button class="accordion-button " type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseTwo" aria-expanded="true" aria-controls="panelsStayOpen-collapseTwo" id="SectionCorreoEmpresa">
                Correo de Empresa
            </button>
        </h2>
        <div id="panelsStayOpen-collapseTwo" class="accordion-collapse collapse ">
            <div class="accordion-body">

                <div class="row">
                    <div class="col">
                        <div class="input-wrapper ">
                            <input type="text" class="input-text form-control" id="txt_serv_Correo" autocomplete="off" maxlength="100">
                            <label for="txt_serv_Correo" class="input-label">Servidor Correo</label>
                        </div>
                    </div>
                    <div class="col">
                        <div class="input-wrapper ">
                            <input type="text" class="input-text form-control" id="txt_port_Correo" autocomplete="off" maxlength="20">
                            <label for="txt_port_Correo" class="input-label">Puerto</label>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="input-wrapper ">
                            <input type="text" class="input-text form-control" id="txt_remitente_Correo" autocomplete="off" maxlength="100">
                            <label for="txt_remitente_Correo" class="input-label">Remitente</label>
                        </div>
                    </div>
                    <div class="col">
                        <div class="input-wrapper ">
                            @*<input type="text" class="input-text form-control" id="txt_prio_Correo" autocomplete="off" maxlength="20">*@
                            <select class="form-select" id="txt_prio_Correo">
                                <option value="Baja">Baja</option>
                                <option value="Media">Media</option>
                                <option value="Alta">Alta</option>
                            </select>
                            <label for="txt_prio_Correo" class="select-label">Prioridad</label>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div id="" class="input-wrapper">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" @*role="switch"*@ id="chkAuth_Correo">
                                <label class="form-check-label" for="chkAuth_Correo">Autenticación</label>
                            </div>

                        </div>
                    </div>
                    <div class="col">
                        <div id="" class="input-wrapper">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" @*role="switch"*@ id="chkSSL_Correo">
                                <label class="form-check-label" for="chkSSL_Correo">Habilitar SSL</label>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <div class="input-wrapper ">
                            <input type="text" class="input-text form-control" id="txt_usuario_Correo" autocomplete="off" maxlength="100">
                            <label for="txt_usuario_Correo" class="select-label">Usuario</label>
                        </div>
                    </div>
                    <div class="col">
                        <div class="input-wrapper ">
                            <input type="text" class="input-text form-control" id="txt_pass_Correo" autocomplete="off" maxlength="20">
                            <label for="txt_pass_Correo" class="select-label">Contraseña</label>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <button class="btn btn-success btn-lg float-end" id="btn_Save_Correo">Guardar Correo <i class="fa-solid fa-envelope-circle-check"></i></button>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="accordion-item accordion_block">
        <h2 class="accordion-header">
            <button class="accordion-button " type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseThree" aria-expanded="true" aria-controls="panelsStayOpen-collapseThree" id="SectionImg">
                Imagen de Banner
            </button>
        </h2>
        <div id="panelsStayOpen-collapseThree" class="accordion-collapse collapse ">
            <div class="accordion-body">
                <div class=" row">
                    <div class="col ">
                        <br />
                        <div class="formulario_contenedor">
                            <div class="row ">
                                <div class="col flex_flex-center">
                                    <input class="form-control form-control" id="archivo" type="file" accept=".png,.jpg,.jpeg">
                                </div>
                            </div>
                            <br />

                            <div class="row ">
                                <div class="col grid_grid-center">
                                    <div id="cropped-image"></div>
                                </div>
                            </div>

                            <div class="row ">
                                <div class="col">
                                    <button type="button" class="btn btn-lg btn-danger float-end margin-2_5Px" id="Delete_image" >Eliminar Banner</button>
                                    <button type="button" class="btn btn-lg btn-primary float-end margin-2_5Px" id="Save_image" >Guardar</button>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
    <div class="accordion-item accordion_block">
        <h2 class="accordion-header">
            <button class="accordion-button " type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseFour" aria-expanded="true" aria-controls="panelsStayOpen-collapseFour">
                Imagen de Fondo
            </button>
        </h2>
        <div id="panelsStayOpen-collapseFour" class="accordion-collapse collapse ">
            <div class="accordion-body">
                <div class=" row">

                    <div class="col">
                        <br />
                        <div class="formulario_contenedor">

                            <div class="row ">
                                <div class="col flex_flex-center">
                                    <input class="form-control form-control" id="archivoFondo" type="file" accept=".jpg,.jpeg">
                                </div>
                            </div>
                            <br />

                            <div class="row ">
                                <div class="col">
                                    <button type="button" class="btn btn-lg btn-danger float-end margin-2_5Px" id="Delete_image_fondo" >Eliminar Imagen</button>
                                    <button type="button" class="btn btn-lg btn-primary float-end margin-2_5Px" id="Save_image_fondo" >Guardar</button>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="accordion-item accordion_block">
        <h2 class="accordion-header">
            <button class="accordion-button " type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseFive" aria-expanded="true" aria-controls="panelsStayOpen-collapseFive">
                Imagen de Reportes Excel
            </button>
        </h2>
        <div id="panelsStayOpen-collapseFive" class="accordion-collapse collapse ">
            <div class="accordion-body">
                <div class=" row">

                    <div class="col">
                        <br />
                        <div class="formulario_contenedor">

                            <div class="row ">
                                <div class="col flex_flex-center">
                                    <input class="form-control form-control" id="archivoExcel" type="file" accept=".png,.jpg,.jpeg">
                                </div>
                            </div>
                            <br />

                            @*<div class="row ">
                                    <div class="col" style="display: grid; justify-content: center;">
                                        <div id="cropped-image-Excel"></div>
                                    </div>
                                </div>*@

                            <div class="row ">
                                <div class="col">
                                    <button type="button" class="btn btn-lg btn-danger float-end margin-2_5Px" id="Delete_image_excel" >Eliminar Imagen</button>
                                    <button type="button" class="btn btn-lg btn-primary float-end margin-2_5Px" id="Save_image_excel" >Guardar</button>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="~/Assets/JS/cdn/! jQuery UI - v1.13.2 - 2022-07-14.js"></script>
    <script src="~/Assets/JS/cdn/croppie.min.js"></script>
    <script src="~/Assets/JS/ConfigJS/ConfigJS.js"></script>
    <script nonce="@nonce">
        $(document).ready(function () {
            toggle_Loadingtb('tbLoading', false);
        });

        var SubnavIndex = @ViewBag.SubNavIndex.ToString();
        //Console.log(SubnavIndex);
        switch (SubnavIndex) {
            case 1: $('#panelsStayOpen-collapseOne').addClass('show'); break;
            case 2: $('#panelsStayOpen-collapseTwo').addClass('show'); break;
            case 3: $('#panelsStayOpen-collapseThree').addClass('show'); $('#panelsStayOpen-collapseFour').addClass('show'); $('#panelsStayOpen-collapseFive').addClass('show');

                break;

            default: ; break;
        }

    </script>
}