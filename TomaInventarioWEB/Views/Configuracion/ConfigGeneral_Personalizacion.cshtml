                        <i class="ti ti-file-spreadsheet"></i>
                    </div>
                </div>
                <!-- Opciones -->
                <div class="col-md-4">
                    <div class="mb-4">
                        <label for="archivoExcel" class="form-label contenedor__subtitulo mb-2">Logo en reportes Excel</label>
                        <input id="archivoExcel" class="form-control" type="file" accept=".png,.jpg,.jpeg">
                        <div class="invalid-feedback">Debe seleccionar una imagen</div>
                        <small class="text-muted">
                            <i class="ti ti-info-circle fs-4"></i>
