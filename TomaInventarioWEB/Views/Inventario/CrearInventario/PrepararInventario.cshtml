        /* MENSAJE PARA INPUT INVALIDO */
        function inputInvalido(elemento, mensaje) {
            //const mensajeInvalido = input.nextElementSibling;

            //mensajeInvalido.textContent = mensaje;
            //input.classList.remove("is-valid");
            //input.classList.add("is-invalid");

            elemento.classList.add("is-invalid");

            if ($(elemento).hasClass("select2-hidden-accessible")) {
                $(elemento).next('.select2-container').addClass("is-invalid");
            }

            let feedback = elemento.parentElement.querySelector(".invalid-feedback");
            if (feedback) feedback.textContent = mensaje;
        }
        function limpiarInvalido(elemento) {
            //const mensajeInvalido = input.nextElementSibling;

            //input.classList.remove("is-invalid");

            elemento.classList.remove("is-invalid");

            elemento.classList.remove("is-invalid");

            if ($(elemento).hasClass("select2-hidden-accessible")) {
                $(elemento).next('.select2-container').removeClass("is-invalid");
            }
        }



        /*// GENERAR CODIGO DE INVENTARIO //*/
        const btnGenerarCodInventario = document.getElementById("btnGenerarCodInv");
        const inputCodInventario = document.getElementById("txt_New_CodInventario");
        const lblInfoCodInventario = document.getElementById("infoCodInv");

        btnGenerarCodInventario.addEventListener("click", function () {

            inputCodInventario.value = generarCodInventario();
            limpiarInvalido(inputCodInventario);
            lblInfoCodInventario.classList.remove("d-none");
        });

        function generarCodInventario() {
            const ahora = new Date();
            //console.log(ahora);

            const dd = String(ahora.getDate()).padStart(2, "0");
            const mm = String(ahora.getMonth()+1).padStart(2, "0");
            const yy = String(ahora.getFullYear()).slice(-2);

            const hh = String(ahora.getHours()).padStart(2, "0");
            const min = String(ahora.getMinutes()).padStart(2, "0");

            return `INV_${dd}${mm}${yy}_${hh}${min}`;
        }


