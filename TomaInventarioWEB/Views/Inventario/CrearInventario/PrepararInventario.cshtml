@section scripts{
    <script src="~/Assets/JS/InventarioJS/PrepararInventario.js"></script>
    <script src="~/Content/matdash/libs/jquery-steps/build/jquery.steps.min.js"></script>
    <script src="~/Content/matdash/libs/jquery-validation/dist/jquery.validate.min.js"></script>

    <script nonce="@nonce">

        /* PROTEGER SALIDA DE LA PAGINA */
        let hayCambios = false;
        let urlDestino = null;
        let esDescarga = false;
        let esVideo = true;

        // Advertencia si el usuario escoge otra opcion
        document.querySelectorAll("a").forEach(link => {
            link.addEventListener("click", function (e) {
                if (!hayCambios || e.target.id =="videoInv") return;

                e.preventDefault();
                urlDestino = this.href;
                
                Swal.fire({
                    title: "¿Estas seguro de salir?",
                    text: "Si sales ahora, perderás el progreso realizado.",
                    icon: "warning",
                    showCancelButton: true,
                    cancelButtonColor: "#d33",
                    cancelButtonText:"Cancelar",
                    confirmButtonText: "Salir"
                }).then((result) => {
                    if (result.isConfirmed) {
                        hayCambios = false;
                        window.location.href = urlDestino;
                    } else if (result.isDenied) {
                        hayCambios = true;
                    }
                });
            });
        });

        // Marca cambios cuando el usuario edita algo
        document.addEventListener("input", () => {
            hayCambios = true;
        });

        // Advertencia del navegador
        window.addEventListener("beforeunload", function (e) {
            if (!hayCambios || esDescarga) return;

            e.preventDefault();
            e.returnValue = ""; // obligatorio para que el navegador muestre el aviso
        });   



        /* FORMULARIO WIZARD */
        const formularioPasos = document.getElementById("PasosPrepararInventario");
        //const modalProdNoImport = new bootstrap.Modal(document.getElementById("modal_productosNoImportados"));
        const urlGestionar = '@Url.Action("GestionInventario", "Inventario")';
        const inputAlmacen = document.getElementById("cbxAlmacen_NewInv");
        const inputUbicacion = document.getElementById("cbxUbicacion_NewInv");
        $("#PasosPrepararInventario").steps({
            headerTag: "h6",
            bodyTag: "section",
            transitionEffect: "fade",
            enableAllSteps:false,
            titleTemplate: `<span class="step">#index#</span>#title#`,
            labels: {
                finish: "Finalizar",
                next: "Siguiente",
                previous:"Anterior"
            },

            onInit: function (event, currentIndex) {
                LoadCbxAlmacenInv();
                let idAlmacen = $("#cbxAlmacen_NewInv").val();
                LoadCbxUbiInv(idAlmacen);
                LoadCbxProdInv("");
                LoadUndMed();
                InicializarTablaCrearInv();
            },

            onStepChanging: function (event, currentIndex, newIndex) {

                if (newIndex < currentIndex) return true;

                //Validacion paso 1 antes del 2
                if (currentIndex === 0) {
                    let camposValidos = validarCamposLlenados(formularioPasos);
                    let existenciaInv = validarExistenciaInv();

                    return camposValidos && existenciaInv;
                }

                if (currentIndex === 1) {
                    let texto = $("#cbxAlmacen_NewInv option:selected").text();
                    document.getElementById("almacenActual").textContent = "Almacen: " + texto;
                }

                hayCambios = true;
                return true;
            },

            onStepChanged: function (event, currentIndex) {
                let btnSiguiente = $('a[href="#next"]').closest('li');
                let btnAnterior = $('a[href="#previous"]').closest('li');

                btnSiguiente.removeClass("d-none");

                if (currentIndex === 1) {
                    btnSiguiente.addClass("d-none");
                    btnAnterior.addClass("d-none");

                    $("#txt_New_CodInventario").prop("disabled", true);
                    $("#btnGenerarCodInv").prop("disabled", true);
                    $("#cbxAlmacen_NewInv").prop("disabled", true);
                    /*$("#cbxUbicacion_NewInv").prop("disabled", true);*/
                }

                if (currentIndex === 2) {
                    btnAnterior.removeClass("d-none");
                }
            },

            onFinishing: function (event, currentIndex) {
                Swal.fire({
                    title: "¿Estas seguro de finalizar la preparación?",
                    text: "Se recomienda verificar que todos los productos a inventariar se encuentren en la tabla.",
                    icon: "warning",
                    showCancelButton: true,
                    cancelButtonColor: "#d33",
                    cancelButtonText: "Cancelar",
                    confirmButtonText: "Finalizar"
                }).then((result) => {
                    if (result.isConfirmed) {
                        hayCambios = false;
                        GuardarInventarioPreparado();
                        return true;
                    } else if (result.isDenied) {
                        hayCambios = true;
                    }
                });

                //console.log("terminando");
                //GuardarInventarioPreparado();
                //hayCambios = false;
                //return true;
            }

            @*onFinished: function (event, currentIndex) {
                console.log("terminado");
                window.location.href = '@Url.Action("Index", "Home")';
                return true;
            }*@
        });



        /* VALIDAR Y AGREGAR PRODUCTO A LA TABLA */
        const btnAgregarProducto = document.querySelector("#btnAgregar");
        const inputProducto = document.getElementById("cbxProducto_NewInv");
        const inputStock = document.getElementById("txtStock_NewInv");
        const inputLote = document.getElementById("txtLote_NewInv");
        btnAgregarProducto.addEventListener("click", () => {

            if (inputProducto.value.trim() === "" || inputProducto.value === "-1") {
                inputInvalido(inputProducto, "Este campo es requerido");
                return;
            }
            limpiarInvalido(inputProducto);

            if (!inputStock.value) {
                inputInvalido(inputStock, "Este campo es requerido");
                return;
            }
            limpiarInvalido(inputStock);

            AgregarNuevoProducto();
            inputStock.value = "";
            inputLote.value = "";
        });



        // Validacion del campo Stock 
        inputStock.addEventListener("input", function () {
            let value = inputStock.value;

            // Evitar espacio en blanco
            if (value === "") return;

            // Evitar signo negativo
            if (value.startsWith("-")) {
                inputStock.value = value.replace("-", "");
                return;
            }

            // Permitir solo numeros y .
            if (!/^\d*\.?\d*$/.test(value)) {
                inputStock.value = value.slice(0, -1);
                return;
            }

            const partes = value.split(".");
            let entero = partes[0];
            let decimal = partes[1];

            if (entero.length > 5) {
                entero = entero.slice(0, 5);
            }

            if (decimal && decimal.length > 3) {
                decimal = decimal.slice(0, 3);
            }

            inputStock.value = decimal !== undefined
                ? `${entero}.${decimal}`
                : entero;
        });



        // Actualizar unidades de medida
        $('#cbxProducto_NewInv').change(function () {
            LoadUndMed();
        })



        /* VALIDAR EL MODAL DE IMPORTACION Y PASA AL SIGUIENTE */
        const inputInventarioFile = document.getElementById("CrearInv_fileInput");
        const btnImportarInventario = document.getElementById("CrearInv_btn_Import");
        btnImportarInventario.addEventListener("click", () =>{
            // si esta validado siguiente paso
            if (!validarArchivoInventario(inputInventarioFile)) {
                return;
            }

            const modalImportar = bootstrap.Modal.getInstance(document.getElementById("modal_importExcel"));
            modalImportar.hide();

            $("#PasosPrepararInventario").steps("next");
        });



        /*// AGREGAR INVENTARIO POR IMPORTACION EXCEL //*/
        var importacionId = ""; // Identificador para la tabla temporar a la hora de importar

        $('#CrearInv_btn_Import').click(function () {

            var formData = new FormData();
            formData.append("archivo", $("#CrearInv_fileInput")[0].files[0]);
            formData.append("IdAlmacen", $('#cbxAlmacen_NewInv').val());

            Swal.fire({
                title: 'Preparando inventario...',
                html: 'Validando e importando los productos.<br><br>Por favor espere.',
                allowOutsideClick: false,
                allowEscapeKey: false,
                allowEnterKey: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            /*toggle_Loadingtb('tbLoading', true);*/
            $.ajax({
                url: '@Url.Action("SubirArchivo_Detalle", "Importacion")',
                type: 'POST',
