@{
    ViewBag.Title = "PrepararInventario";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string nonce = (string)HttpContext.Current.Items["ScriptNonce"];
}

<div class="card">
    <!-- Titulo -->
    <div class="card-header card__cabecera">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 card-cabecera__mobile">
            <div class="card-titulo__mobile">
                <h4 class="mb-1 fw-semibold text-white">Preparación de Inventario</h4>
                <h7 class="text-white opacity-75">Realice los preparativos para su próximo inventario</h7>
            </div>
        </div>
    </div>
    <div class="card-body wizard-content">
        <form id="PasosPrepararInventario" class="tab-wizard wizard-circle">
            <!-- Paso 1 -->
            <h6>Datos del inventario</h6>
            <section>
                <div class="row justify-content-center">
                    <div class="col-md-4">
                        <div class="card border p-3">
                            <div class="mb-4">
                                <label for="cbxAlmacen_NewInv" class="form-label contenedor__subtitulo">Seleccionar un Almacen</label>
                                <div class="position-relative">
                                    <select id="cbxAlmacen_NewInv" class="form-select">
                                        @*<option value="0" selected>--Seleccione un almacen--</option>*@
                                    </select>
                                    <div class="invalid-feedback">Este campo es requerido</div>
                                </div>
                                
                            </div>

                            <div class="mb-4">
                                <label for="txt_New_CodInventario" class="form-label contenedor__subtitulo">Código del Inventario</label>
                                <button type="button" id="btnGenerarCodInv" class="btn btn-success btn-sm ms-2">Generar</button>
                                <div class="position-relative">
                                    <input id="txt_New_CodInventario" type="text" class="form-control input_placeholder" autocomplete="off" @*placeholder="Ejm: Inv_Enero_2025"*@ disabled>
                                    <div class="invalid-feedback">Este campo es requerido</div>
                                </div>                              

                                <small id="infoCodInv" class="text-muted d-none">
                                    <i class="ti ti-info-circle fs-4">
                                    </i>Formato: INV-"Fecha"-"Hora"
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Paso 2 -->
            <h6>Forma de agregar el inventario</h6>
            <section>
                <div class="row justify-content-center">
                    <div class="col-md-4">
                        <div class="card border p-3">
                            <h5 class="text-center mb-3">Seleccione como incluir su inventario</h5>
                            <div class="p-2 d-flex flex-column gap-3">
                                <button type="button" id="btnExcel_crearInv" class="btn btn-primary w-100 d-flex flex-column" data-bs-toggle="modal" data-bs-target="#modal_importExcel">
                                    Importar desde Excel
                                    <small class="text-white-50">Recomendado para grandes cantidades de productos</small>
                                </button>
                                <button type="button" id="btnManual_crearInv" class="btn btn-primary w-100 d-flex flex-column">
                                    Agregar manualmente
                                    <small class="text-white-50">Ideal para agregar pocos productos o hacer correcciones</small>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Paso 3 -->
            <h6>Previsualizacion del inventario</h6>
            <section class="p-0">
                <div class="card border p-2">
                    <h5 id="almacenActual" class="mb-4 mt-1 fw-bold text-primary">Almacen: </h5>
                    <div class="row mx-0 g-2 my-2 justify-content-center">
                        <div class="col-md-3">
                            <p for="cbxUbicacion_NewInv" class="form-label contenedor__subtitulo">Seleccione una Ubicación</p>
                            <select id="cbxUbicacion_NewInv" class="form-control">
                            </select>
                            <div class="invalid-feedback">Este campo es requerido</div>
                        </div>
                        <div class="col-md-3">
                            <p for="cbxProducto_NewInv" class="form-label contenedor__subtitulo">Seleccione un Producto</p>
                            <select id="cbxProducto_NewInv" class="form-control">
                                @*<option value="0" selected>--Seleccione un producto--</option>*@
                            </select>
                            <div class="invalid-feedback">Este campo es requerido</div>
                        </div>
                        <div class="col-md-2">
                            <label for="txtLote_NewInv" class="form-label contenedor__subtitulo">
                                Lote del producto
                                @*<small class="text-muted">(Opcional)</small>*@
                                <i class="ti ti-info-circle text-primary"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="top"
                                   data-bs-html="true"
                                   data-bs-title="Campo opcional">
                                </i>
                            </label>
                            <input id="txtLote_NewInv" type="text" class="form-control input_placeholder" autocomplete="off" placeholder="">
                        </div>
                        <div class="col-md-2">
                            <div class="d-flex justify-content-between">
                                <label for="txtStock_NewInv" class="form-label contenedor__subtitulo">
                                    Stock
                                    @*<i id="infoUM" class="ti ti-info-circle text-primary"
                                       data-bs-toggle="tooltip"
                                       data-bs-placement="top"
                                       data-bs-html="true"
                                       data-bs-title="Unidad de medida"
                                       mult="">
                                    </i>*@
                                </label>
                                <div>
                                    <i class="ti ti-info-circle fs-3 text-muted"></i>
                                    <small class="text-muted fw-bold" id="UMText" mult=""></small>
                                </div>
                            </div>
                            <div class="position-relative">
                                <input id="txtStock_NewInv" type="number" class="form-control input_placeholder" autocomplete="off">
                                <div class="invalid-feedback">Este campo es requerido</div>
                            </div> 
                        </div>
                        <div class="col-md-2 d-flex justify-content-center gap-3 align-items-end flex-wrap">
                            <button type="button" id="btnAgregar" class="btn btn-primary">Agregar</button>
                            <button type="button" id="btnEliminarFila" class="btn btn-danger">Eliminar</button>
                        </div>
                    </div>
                    <!--tabla-->
                    <hr class="mb-4">
                    <div class="table-responsive">
                        <table id="tbl_addProductos" class="table table-hover w-100">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Cod. Inventario</th>
                                    <th scope="col">Cod. Ubicación</th>
                                    <th scope="col">Dsc. Ubicación</th>
                                    <th scope="col">Cod. Producto</th>
                                    <th scope="col">Dsc. Producto</th>
                                    <th scope="col">Lote Producto</th>
                                    <th scope="col">Stock Actual</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        </form>
    </div>
</div>

<!-- MODAL IMPORTACION -->
<div class="modal fade" id="modal_importExcel" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <div class="d-flex">
                    <div class="me-3">
                        <h5 class="modal-title fw-bold mb-1">
                            <i class="ti ti-file-import me-2 text-primary"></i>Importar Inventario
                        </h5>
                        <p class="mb-0 text-muted fs-2">Cargue su inventario desde un archivo Excel</p>
                    </div>                  
                    <a href="https://www.youtube.com/watch?v=c1M2HYaEj8I" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary d-flex align-items-center justify-content-center" id="videoInv">
                        ¿Necesitas ayuda?
                        <i class="ti ti-brand-youtube ms-1 fs-6"></i>
                    </a>
                </div>        
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body py-4">
                <div class="mb-4">
                    <div class="d-flex align-items-start">
                        <div class="rounded-circle bg-light-primary d-flex align-items-center justify-content-center flex-shrink-0 me-3">
                            <span class="fw-bold text-primary fs-5">1</span>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="fw-semibold mb-2">Descargue la plantilla de Excel</h6>
                            <p class="text-muted mb-3 fs-2">
                                Utilice nuestra plantilla para asegurar que los datos estén en el formato correcto
                            </p>
                            <button id="CrearInv_btnTemplate" type="button" class="btn btn-success btn-sm">
                                <i class="ti ti-download me-1 fs-4"></i>Descargar Plantilla
                            </button>
                        </div>
                    </div>
                </div>

                <div class="border-top my-4"></div>

                <div class="mb-3">
                    <div class="d-flex align-items-start">
                        <div class="rounded-circle bg-light-primary d-flex align-items-center justify-content-center flex-shrink-0 me-3">
                            <span class="fw-bold text-primary fs-5">2</span>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="fw-semibold mb-2">Seleccione el archivo a importar</h6>
                            <p class="text-muted mb-3 fs-2">
                                Complete la plantilla con su inventario y cárguela aquí
                            </p>
                            <div class="mb-2">
                                <input class="form-control" id="CrearInv_fileInput" type="file" accept=".xlsx,.xls">
                                <div class="invalid-feedback">
                                    Por favor seleccione un archivo Excel válido
                                </div>
                            </div>
                            <small class="form-text text-muted">
                                <i class="ti ti-info-circle fs-4"></i> Formatos aceptados: .xlsx, .xls
                            </small>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info d-flex align-items-start mt-4" role="alert">
                    <div class="d-flex flex-column gap-3">
                        @*<div>
                            <i class="ti ti-info-circle me-2 fs-5 flex-shrink-0"></i><strong>Asegúrese de incluir el código de la ubicación del paso anterior</strong>
                        </div>*@
                        <div>
                            <i class="ti ti-info-circle me-2 fs-5 flex-shrink-0"></i><strong>El uso de lote para sus productos es opcional</strong>
                        </div>

                    </div>
                </div>
            </div>

            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                    <i class="ti ti-x me-1 fs-4"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="CrearInv_btn_Import">
                    <i class="ti ti-upload me-1 fs-4"></i>Importar Inventario
                </button>
            </div>
        </div>
    </div>
</div>

