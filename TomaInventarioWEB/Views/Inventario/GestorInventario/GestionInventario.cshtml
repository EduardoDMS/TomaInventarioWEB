    @*<script src="~/Content/matdash/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>*@
    <script src="~/Content/matdash/libs/apexcharts/dist/apexcharts.min.js"></script>
    <script src="~/Assets/JS/InventarioJS/GestionInventario.js"></script>

    <script nonce="@nonce">

        const selectorInventario = document.getElementById("cbxInventarioP");
        const contenidoTabs = document.getElementById("cntTabs");
        const contenidoGestion = document.getElementById("cntGestion");
        const contenidoInformacion = document.getElementById("cntInfo");
        /*const contenedorBtnExportar = document.getElementById("cntbtnExportar");*/
        const lblConteoActual = document.getElementById("conteoActual");


        /*// SELECCION DE INVENTARIO //*/
        selectorInventario.addEventListener("change", function () {
            if (selectorInventario.value === "null") {
                OcultarGestion();
                return;
            }

            MostrarGestion(selectorInventario.value);
            modificarBtnConteo(ConteoActual);
        });


        // Descargar reporte en excel
        async function ExportInventario() {
            const obj = {
                COD_INVENTARIO: Codigo_inventario,
                NRO_CONTEO_1: 0,
                NRO_CONTEO_2: 0,
                NRO_CONTEO_3: 0,
                almacen: Codigo_almacen,
                codigoInventario: Codigo_inventario,
                conteoActual: ConteoActual,
                estadoInventario: EstadoInventario.toUpperCase(),
                searchValue: $('input[type="search"][aria-controls="tbl_Inventario"]').val()
            };
            //console.log(obj);

            Swal.fire({
                title: 'Generando Excel...',
                html: 'Por favor espere',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            try {

                const response = await fetch(
                    '@Url.Action("ExportInventario", "Inventario")',
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(obj)
                    }
                );

                if (!response.ok) {
                    const errorText = await response.text();

                    console.error("ERROR DEL SERVIDOR:");
                    console.error(errorText);

                    throw new Error(errorText || 'No se pudo generar el archivo Excel.');
                }

                // Obtener archivo
                const blob = await response.blob();

                // Crear URL temporal
                const url = window.URL.createObjectURL(blob);

                // Crear enlace de descarga
                const a = document.createElement('a');
                a.href = url;
                a.download = `Avance_Inventario_${obj.codigoInventario}.xlsx`;

                document.body.appendChild(a);
                a.click();

                // Limpiar
                a.remove();
                window.URL.revokeObjectURL(url);

                Swal.close();

            } catch (error) {

                console.error(error);

                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: error.message || 'Ocurrió un error al generar el Excel.'
                });
            }
        }





