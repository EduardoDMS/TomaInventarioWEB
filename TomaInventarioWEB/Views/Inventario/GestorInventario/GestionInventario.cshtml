                            <i class="ti ti-chart-donut fs-4"></i>
                        </span>
                        <span class="d-none d-md-block ms-2">Gráficos</span>
                    </a>
                </li>
                @*<li class="nav-item">
                    <a class="nav-link d-flex align-items-center" data-bs-toggle="tab" href="#tabReportes" role="tab">
                        <span>
                            <i class="ti ti-file-analytics fs-4"></i>
                        </span>
                        <span class="d-none d-md-block ms-2">Reportes</span>
                    </a>
                </li>*@
            </ul>
        </div>
    </div>
    <div class="card-body">
        <!-- Tab panels -->
        <div class="row align-items-center mb-3">
            <div class="col-auto">
                <label for="cbxInventarioP" class="form-label contenedor__subtitulo flex-shrink-0">Seleccionar un Inventario</label>
            </div>
            <div class="col-md-4 mb-2">
                <select id="cbxInventarioP" class="form-select">
                </select>
            </div>
            <div id="cntInfo" class="col d-flex flex-column d-none">
                <small id="lblInvAct" class="text-muted">Inventario actual:</small>
                <small id="lblAlmAct" class="text-muted">Almacen actual:</small>
            </div>
            @*<div id="cntbtnExportar" class="col text-end d-none">
                    <button id="btnExportExcel" class="btn btn-success col-auto"><i class="ti ti-file-spreadsheet fs-5 me-2"></i>Exportar tabla</button>
                </div>*@
        </div>
        <div id="cntGestion" class="tab-content d-none">
            <div class="tab-pane active" id="tabGestor" role="tabpanel">
                @Html.Partial("~/Views/Inventario/GestorInventario/Gestor/GestorInventario.cshtml")
            </div>
            <div class="tab-pane" id="tabGraficos" role="tabpanel">
                @Html.Partial("~/Views/Inventario/GestorInventario/Graficos/GraficosGenerales.cshtml")
            </div>
            <div class="tab-pane" id="tabReportes" role="tabpanel">
                @Html.Partial("~/Views/Inventario/GestorInventario/Reportes/ReportesInventario.cshtml")
            </div>
        </div>
    </div>
</div>

