                <th id="Head_Cont3"></th>   @*Cont 3*@
                <th></th>                   @*Total*@
                <th></th>                   @*Dif*@
            </tr>
        </thead>
        <tbody>
            <tr>
            </tr>
        </tbody>
        <tfoot>
            <tr>
                <th></th>
                <th></th>
                <th></th>
                <th>Total:</th>
                <th id="FCantI">0</th>
                <th id="FCont1">0</th>
                <th id="FCont2">0</th>
                <th id="FCont3">0</th>
                <th id="FTotal">0</th>
                <th id="FDif">0</th>
            </tr>
        </tfoot>
    </table>
</div>





