<hr class="my-3">
<div class="row text-center align-items-center justify-content-center mb-3">
    <div class="col-12 col-md-4 d-flex align-items-center justify-content-center gap-3">
        <h1 class="fw-bolder">CONTEO</h1>
        <h2 id="conteoActual" class="conteo_actual fw-bolder">0</h2>
    </div>
    <div class="col-12 col-md-4 border-start border-end">
        <h4>Productos Inventariados</h4>
        <h1 id="tblConteoData" class="fw-bolder">107/120</h1>
    </div>
    <div class="col-12 col-md-4 d-flex justify-content-around gap-2">
        <button id="btnExportExcel" class="btn btn-success col-auto"><i class="ti ti-file-spreadsheet fs-5 me-2"></i>Exportar tabla</button>
        <button id="FinalizarConteo" class="btn btn-primary">Finalizar conteo actual</button>
    </div>
</div>

<div class="d-flex justify-content-center gap-3">
    <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" id="chkOcultar" checked>
        <label class="form-check-label" for="chkOcultar">Ocultar Lotes</label>
    </div>
    <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" id="chkReload" checked>
        <label class="form-check-label" for="chkReload">Sincronización automática</label>
        <i class="ti ti-info-circle text-primary"
           data-bs-toggle="tooltip"
           data-bs-placement="top"
           data-bs-html="true"
           data-bs-title="Actualiza la tabla periódicamente. ⚠️ <strong>No recomendado</strong> para inventarios grandes, puede afectar el rendimiento.">
        </i>
    </div>
</div>

<hr class="my-3">

<div class="table-responsive">
    <table id="tbl_Inventario" class="table table-hover table-bordered  text-nowrap align-middle dataTable">
        <thead class="table-light">
            <tr>
                <th>Código</th>
                <th>Producto</th>
                <th>Ubicación Inicial</th>
                <th>Lote Inicial</th>
                <th>Ubicación Contada</th>
                <th>Lote Contado</th>
                <th>Stock Inicial</th>
                <th>Conteo 1</th>
                <th>Conteo 2</th>
                <th>Conteo 3</th>
                <th>Total</th>
                <th>Diferencia</th>
            </tr>
        </thead>
        <tbody>
            <tr>
            </tr>
        </tbody>
        <tfoot>
            <tr>
                <th colspan="6" class="fw-bolder">TOTALES</th>
                <th id="FCantI">0</th>
                <th id="FCont1">0</th>
                <th id="FCont2">0</th>
                <th id="FCont3">0</th>
                <th id="FTotal">0</th>
                <th id="FDif">0</th>
            </tr>
        </tfoot>
    </table>
</div>



<!-- Modal Finalizar Conteo -->
<div class="modal fade" id="ModalConteo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5 text-center" id="exampleModalLabel">¿Cómo desea continuar después de finalizar este conteo?</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row justify-content-center">
                    <div class="col-10">
                        <ul class="list-group mb-2">
                            <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                                <label class="form-check-label d-flex flex-column" for="firstRadio">
                                    <div class="d-flex gap-3">
                                        <strong class="text-black">Continuar con el siguiente conteo</strong>
                                        <span class="badge text-bg-primary rounded-pill fs-1">Más usado</span>
                                    </div>
                                    <small class="text-muted">Solo se incluirán los productos con diferencias</small>
                                </label>
                                <input class="form-check-input" type="radio" name="listGroupRadio" value="1" id="firstRadio" checked>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                                <label class="form-check-label d-flex flex-column" for="secondRadio">
                                    <div class="d-flex gap-3">
                                        <strong class="text-black">Recontar todo el inventario</strong>
                                        @*<span class="badge text-bg-warning rounded-pill fs-1">Tomara más tiempo</span>*@
                                    </div>
                                    <small class="text-muted">Se incluirán todos los productos nuevamente</small>
                                </label>
                                <input class="form-check-input" type="radio" name="listGroupRadio" value="2" id="secondRadio">
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                                <label class="form-check-label d-flex flex-column" for="thirdRadio">
                                    <strong class="text-danger">Cerrar inventario</strong>
                                    <small class="text-danger">Finaliza todos los conteos y cierra el inventario</small>
                                </label>
                                <input class="form-check-input" type="radio" name="listGroupRadio" value="3" id="thirdRadio">
                            </li>
                        </ul>
                        <div class="d-flex justify-content-center">
                            <button class="btn btn-success" id="ConfirmarConteo">Confirmar y continuar</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Usuarios -->
<div class="modal fade" id="ModalUsuarios" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content custom_modal_content">
            <div class="modal-header custom_modal_head">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Usuarios Asociados al Almacen</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body custom_modal_body">
                <table id="User_Tbl" class="display responsive nowrap Width100">
                    <thead>
                        <tr>
                        </tr>
                    <thead>
                    <tbody>
                        <tr>
                        </tr>

                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

<!-- Modal Export -->
<div class="modal fade" id="ModalExport" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered ">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5 text-center" id="exampleModalLabel">¿Qué información desea exportar a Excel?</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row justify-content-center">
                    <div class="col-10">
                        <div class="mb-2">
                            <strong>Exportar un conteo específico</strong>
                            <small class="d-block text-muted mb-2">
                                Se descargará la tabla con solo el conteo seleccionado.
                            </small>
                            <ul class="list-group">
                                <li class="list-group-item">
                                    <input class="form-check-input me-1" type="radio" name="ListRadioExcel" value="1" id="1RadioExcel" checked>
                                    <label class="form-check-label" for="1RadioExcel">Conteo 1</label>
                                </li>
                                <li class="list-group-item">
                                    <input class="form-check-input me-1" type="radio" name="ListRadioExcel" value="2" id="2RadioExcel">
                                    <label class="form-check-label" for="2RadioExcel">Conteo 2</label>
                                </li>
                                <li class="list-group-item">
                                    <input class="form-check-input me-1" type="radio" name="ListRadioExcel" value="3" id="3RadioExcel">
                                    <label class="form-check-label" for="3RadioExcel">Conteo 3</label>
                                </li>
                            </ul>
                        </div>
                        <div class="mb-2">
                            <strong>Exportar la tabla completa</strong>
                            <small class="d-block text-muted mb-2">
                                Incluye todos los conteos.
                            </small>
                            <ul class="list-group">
                                <li class="list-group-item">
                                    <input class="form-check-input me-1" type="radio" name="ListRadioExcel" value="4" id="4RadioExcel">
                                    <label class="form-check-label" for="4RadioExcel">Resumen total de los conteos</label>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="d-flex justify-content-center">
                        <button class="btn btn-success float-end" id="ConfirmarExport">Descargar Excel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>