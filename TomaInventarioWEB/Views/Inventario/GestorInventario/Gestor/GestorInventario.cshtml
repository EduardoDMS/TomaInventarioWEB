</div>

@* Modal Export  *@
<div class="modal fade" id="ModalExport" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered ">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5 text-center" id="exampleModalLabel">¿Qué información desea exportar a Excel?</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row justify-content-center">
                    <div class="col-10">
                        <div class="mb-2">
                            <strong>Exportar un conteo específico</strong>
                            <small class="d-block text-muted mb-2">
                                Se descargará la tabla con solo el conteo seleccionado.
                            </small>
                            <ul class="list-group">
                                <li class="list-group-item">
                                    <input class="form-check-input me-1" type="radio" name="ListRadioExcel" value="1" id="1RadioExcel" checked>
                                    <label class="form-check-label" for="1RadioExcel">Conteo 1</label>
                                </li>
                                <li class="list-group-item">
                                    <input class="form-check-input me-1" type="radio" name="ListRadioExcel" value="2" id="2RadioExcel">
                                    <label class="form-check-label" for="2RadioExcel">Conteo 2</label>
                                </li>
                                <li class="list-group-item">
                                    <input class="form-check-input me-1" type="radio" name="ListRadioExcel" value="3" id="3RadioExcel">
                                    <label class="form-check-label" for="3RadioExcel">Conteo 3</label>
                                </li>
                            </ul>
                        </div>
                        <div class="mb-2">
                            <strong>Exportar la tabla completa</strong>
                            <small class="d-block text-muted mb-2">
                                Incluye todos los conteos.
                            </small>
                            <ul class="list-group">
                                <li class="list-group-item">
                                    <input class="form-check-input me-1" type="radio" name="ListRadioExcel" value="4" id="4RadioExcel">
                                    <label class="form-check-label" for="4RadioExcel">Resumen total de los conteos</label>
                                </li>
                            </ul>
                        </div>
                    </div>  
                    <div class="d-flex justify-content-center">
                        <button class="btn btn-success float-end" id="ConfirmarExport">Descargar Excel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>