@* Modal Finalizar Conteo  *@
<div class="modal fade" id="ModalConteo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5 text-center" id="exampleModalLabel">¿Cómo desea continuar después de finalizar este conteo?</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row justify-content-center">
                    <div class="col-10">
                        <ul class="list-group mb-2">
                            <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                                <label class="form-check-label d-flex flex-column" for="firstRadio">
                                    <div class="d-flex gap-3">
                                        <strong class="text-black">Continuar con el siguiente conteo</strong>
                                        <span class="badge text-bg-primary rounded-pill fs-1">Más usado</span>
                                    </div>                     
                                    <small class="text-muted">Solo se incluirán los productos con diferencias</small>
                                </label>
                                <input class="form-check-input" type="radio" name="listGroupRadio" value="1" id="firstRadio" checked>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                                <label class="form-check-label d-flex flex-column" for="secondRadio">
                                    <div class="d-flex gap-3">
                                        <strong class="text-black">Recontar todo el inventario</strong>
                                        @*<span class="badge text-bg-warning rounded-pill fs-1">Tomara más tiempo</span>*@
                                    </div>   
                                    <small class="text-muted">Se incluirán todos los productos nuevamente</small>
                                </label>
                                <input class="form-check-input" type="radio" name="listGroupRadio" value="2" id="secondRadio">
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                                <label class="form-check-label d-flex flex-column" for="thirdRadio">
                                    <strong class="text-danger">Cerrar inventario</strong>
                                    <small class="text-danger">Finaliza todos los conteos y cierra el inventario</small>
                                </label>
                                <input class="form-check-input" type="radio" name="listGroupRadio" value="3" id="thirdRadio">
                            </li>
                        </ul>
                        <div class="d-flex justify-content-center">
                            <button class="btn btn-success" id="ConfirmarConteo">Confirmar y continuar</button>
                        </div>   
                    </div>                  
                </div>
            </div>
        </div>
    </div>
</div>

