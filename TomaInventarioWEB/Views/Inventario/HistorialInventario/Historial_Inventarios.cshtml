@{
    ViewBag.Title = "Historial Inventarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string nonce = (string)HttpContext.Current.Items["ScriptNonce"];
}
<link href="~/Content/matdash/libs/apexcharts/dist/apexcharts.css" rel="stylesheet" />

<!-- Sección Seleccionar Almacen e inventario -->
<div class="card text-bg-primary text-white mb-3">
    <div class="card-body p-3">
        <div class="d-flex align-items-center justify-content-center">
            <h2 class="fs-8 fw-bolder text-white mb-0">Historial de Inventarios</h2>
            @*<button id="btnExcel">Descargar excel</button>*@
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row">
            <!-- ALMACEN -->
            <div class="col-md-6">
                <h5 class="card-title mb-3 fw-semibold">
                    <i class="ti ti-building-warehouse me-2"></i>
                    Seleccionar un almacen
                </h5>

                <div>
                    <div class="">
                        <select class="form-select" id="cbxAlmacenes">
                            @foreach (var item in ViewBag.ListaAlmacenes)
                            {
                                <option value="@item.vchValue">@item.vchdesc</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<!-- Productos con Diferencias -->
<div id="seccionHistorial" class="row d-none">
    <!--d-none">-->
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <!-- Informacion General: Almacen, Código de inventario, Estado de inventario, Conteo actual -->
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-semibold mb-0">Gráfico del almacen</h6>
                </div>
                <div id="chart-line-basic" class="mb-3 mx-2"></div>

                <!-- Filtros -->
                <!-- Busqueda(Producto, Ubicacion, Lote), Estado(todos, coincide, diferencia, nuevos), tipo de diferencia(todos, sobrante, faltante) -->
                <div class="accordion mb-4" id="accordionFiltros">
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                <h6 class="fs-4 mb-0">Filtros de búsqueda </h6>
                                @*<small class="text-muted ms-1">(Opcional)</small>*@
                            </button>
                        </h2>
                        <div id="collapseOne" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                            <div class="accordion-body row">
                                <!-- Busqueda general -->
                                <div class="col-md-4 mb-2">
                                    <label for="busquedaGeneral" class="form-label">Búsqueda general</label>
                                    <div class="input-group">
                                        <input id="busquedaGeneral" type="text" class="form-control" placeholder="Código de inventario">
                                        <button id="btnLimpiarBusqueda" class="btn btn-outline-muted" type="button">
                                            <i class="ti ti-eraser fs-4"></i>
                                        </button>
                                    </div>
                                    @*<input type="text" class="form-control" id="busquedaGeneral" placeholder="Código o descripción del producto" />*@
                                </div>

                                <!-- Seleccionar mes -->
                                <div class="col-md-4 mb-2">
                                    <label for="slcMes" class="form-label">Mes</label>
                                    <select id="slcMes" class="form-select">
                                        <option value="0" selected>Todos</option>
                                        <option value="1">Enero</option>
                                        <option value="2">Febrero</option>
                                        <option value="3">Marzo</option>
                                        <option value="4">Abril</option>
                                        <option value="5">Mayo</option>
                                        <option value="6">Junio</option>
                                        <option value="7">Julio</option>
                                        <option value="8">Agosto</option>
                                        <option value="9">Septiembre</option>
                                        <option value="10">Octubre</option>
                                        <option value="11">Noviembre</option>
                                        <option value="12">Diciembre</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-semibold mb-0">Mis inventarios realizados</h6>
                </div>
                <!-- Tabla -->
                <!-- Código, Producto, Ubicación, Lote, Stock Inicial, Stock Final, Diferencia, Estado -->
                <div class="table-responsive">
                    <table id="TblInventaroHistorial" class="table table-hover table-bordered  text-nowrap align-middle dataTable">
                        <thead class="table-light">
                            <tr>
                                <th class="text-center">Código de inventario</th>
                                <th class="text-center">Total de conteos</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Fecha Inicio</th>
                                <th class="text-center">Fecha Fin</th>
                                <th class="text-center">Duración inventario</th>
                                <th class="text-center">Faltantes</th>
                                <th class="text-center">Sobrantes</th>
                                <th class="text-center">Excel importado</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                        @*<tfoot class="table-light">
                    <tr>
                        <td colspan="2" class="fw-bolder">TOTALES</td>
                        <td class="text-end fw-bold" id="footerStockInicial">0</td>
                        <td class="text-end fw-bold" id="footerStockFinal">0</td>
                        <td class="text-end fw-bold" id="footerStockDiferencial">0</td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>*@
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Content/matdash/libs/apexcharts/dist/apexcharts.min.js"></script>
    <script nonce="@nonce">
            let modoFiltrado;
        let TblInventaroHistorial;
        let codAlmacenSeleccionado = '';
            let inventarioSeleccionado = {
                almacen:'',
                codigo: '',
            };

            $(document).ready(function () {
                inicializarComponentes();
                inicializarEventos();
            });

            function inicializarComponentes() {
                $('#cbxAlmacenes').select2({
                    width: '100%',
                    placeholder: 'Seleccione un almacen',
                    allowClear: false,
                    language: {
                        noResults: function () { return "No se encontraron resultados"; },
                        searching: function () { return "Buscando..."; }
                    }
                });

                $('#cbxAlmacenes').on('change', function () {
                    codAlmacenSeleccionado = $(this).val();
                    if (codAlmacenSeleccionado) {
                        /*CargarHistorialDeInventariosXalmacen(codAlmacenSeleccionado);*/
                        cargarDatosInventario();
                    }
                });
            }

            function inicializarEventos() {

                // Busqueda general
                let timeoutBusqueda = null;

                $('#busquedaGeneral').on('input', function () {
                    if (modoFiltrado === "LOCAL") {
                        TblInventaroHistorial.search(this.value, false, false).draw();
                        return;
                    }

                    clearTimeout(timeoutBusqueda);

                    timeoutBusqueda = setTimeout(() => {
                        CargarHistorialDeInventariosXalmacen(codAlmacenSeleccionado);
                    }, 400);
                })

                $('#busquedaGeneral').on('keydown', function (e) {
                    if (e.key !== "Enter")
                        return;

                    clearTimeout(timeoutBusqueda);

                    CargarHistorialDeInventariosXalmacen(codAlmacenSeleccionado);
                });

                // Limpiar busqueda
                $('#btnLimpiarBusqueda').on('click', function () {
                    $('#busquedaGeneral').val('');
                    TblInventaroHistorial.search('').draw();
                    CargarHistorialDeInventariosXalmacen(codAlmacenSeleccionado);
                });

                // Filtro mes
                $('#slcMes').on('change', function () {
                    //if (modoFiltrado === "SERVIDOR") {
                    //    CargarHistorialDeInventariosXalmacen(codAlmacenSeleccionado);
                    //} else {
                    //    TblInventaroHistorial.column(6).search($(this).val() === "Todos" ? "" : $(this).val()).draw();
                    //}
                    CargarHistorialDeInventariosXalmacen(codAlmacenSeleccionado);
                });

                $('#TblInventaroHistorial tbody').on(
                    'click',
                    '.btnExcelHistorial',
                    function () {

                        const codInventario = $(this).data('cod-inventario');

                        //console.log("Excel del inventario:", codInventario);

                        ExportarExcel(codInventario);
                    }
                );
            }

        function cargarDatosInventario() {
                $('#busquedaGeneral').val('');
                $('#slcMes').val('0');

                CargarHistorialInventarioGrafico(codAlmacenSeleccionado);
                CargarHistorialDeInventariosXalmacen(codAlmacenSeleccionado);
                
                /*TblInventaroHistorial.search('').draw();*/

                $('#seccionHistorial').removeClass('d-none');
            }

            let chart_line_basic = null;

            async function CargarHistorialInventarioGrafico(codAlmacen) {
                const obj = {
                    cod_almacen: codAlmacen,
                };
                //console.log(obj);
                try {
                    const response = await fetch("HistorialInventarioGrafico", {
                        method: 'POST',
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(obj)
                    });

                    if (!response.ok) { throw new Error(`Error HTTP: ${response.status}`); }

                    const result = await response.json();
                    //console.log(result);

                    if (result.HUBO_ERROR) { // no lo estabas chequeando tampoco
                        console.error(result.MENSAJE_ERROR);
                        return;
                    }

                    const inventarios = result.Entity;
                    CargarGraficoHistorial(inventarios);
                }
                catch (error) {
                    console.error("Error:", error);
                }
            }

            function CargarGraficoHistorial(inventarios) {
                //console.log(inventarios);
                const categorias = inventarios.map(x => x.CodigoInventario);

                const diferencias = inventarios.map(x => x.Diferencias);

                var options_line = {

                    series: [
                        {
                            name: "Productos con diferencias",
                            data: diferencias
                        }
                    ],

                    chart: {
                        height: 350,
                        type: "line",
                        fontFamily: "inherit",

                        zoom: {
                            enabled: false
                        },

                        offsetX: -10,

                        toolbar: {
                            show: false
                        }
                    },

                    dataLabels: {
                        enabled: false
                    },

                    colors: ["var(--bs-primary)"],

                    stroke: {
                        curve: "straight"
                    },

                    grid: {
                        row: {
                            colors: ["transparent"],
                            opacity: 0.5
                        },

                        padding: {
                            top: 0,
                            right: 0,
                            bottom: 0,
                            left: 0
                        },

                        borderColor: "transparent"
                    },

                    xaxis: {

                        categories: categorias,

                        labels: {
                            style: {
                                colors: "#a1aab2"
                            }
                        }
                    },

                    yaxis: {

                        title: {
                            text: "Productos con diferencias"
                        },

                        labels: {
                            style: {
                                colors: "#a1aab2"
                            }
                        }
                    },

                    tooltip: {

                        theme: "dark",

                        custom: function ({ dataPointIndex }) {

                            const inventario = inventarios[dataPointIndex];

                            return `
                        <div class="px-3 py-2">

                            <div class="fw-semibold mb-2">
                                ${inventario.CodigoInventario}
                            </div>

                            <div>
                                <strong>Diferencias:</strong>
                                ${inventario.Diferencias}
                            </div>

                            <div>
                                <strong class="text-success">Sobrantes:</strong>
                                ${inventario.Sobrantes}
                            </div>

                            <div>
                                <strong class="text-danger">Faltantes:</strong>
                                ${inventario.Faltantes}
                            </div>

                        </div>
                    `;
                        }
                    }
                };

                if (chart_line_basic) {
                    chart_line_basic.destroy();
                }

                chart_line_basic = new ApexCharts(
                    document.querySelector("#chart-line-basic"),
                    options_line
                );

                chart_line_basic.render();
            }

            async function CargarHistorialDeInventariosXalmacen(codAlmacen) {
                const obj = {
                    cod_almacen: codAlmacen,
                    cod_inventario: $('#busquedaGeneral').val().trim() || null,
                    mes: parseInt($('#slcMes').val(), 10) || 0
                };
                //console.log(obj);
                try {
                    const response = await fetch("HistorialInventario", {
                        method: 'POST',
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(obj)
                    });

                    if (!response.ok) { throw new Error(`Error HTTP: ${response.status}`); }

                    const result = await response.json();

                    if (result.HUBO_ERROR) {
                        console.error(result.MENSAJE_ERROR);
                        return;
                    }

                    CargarTabla(result.Entity);
                }
                catch (error) {
                    console.error("Error:", error);
                }
            }

            function CargarTabla(datos) {

                if ($.fn.DataTable.isDataTable('#TblInventaroHistorial')) {
                    $('#TblInventaroHistorial').DataTable().destroy();
                }
                $('#TblInventaroHistorial tbody').empty();
                //TblInventaroHistorial
                //tblReporteInventario
                TblInventaroHistorial = $('#TblInventaroHistorial').DataTable({

                    data: datos,

                    columns: [
                        {
                            data: "CodigoDeInventario",
                            className: "text-center"
                        },

                        {
                            data: "UltimoNumeroConteo",
                            className: "text-center"
                        },

                        {
                            data: "EstadoDeInventario",
                            className: "text-center"
                        },

                        {
                            data: "FechaInicio",
                            className: "text-center"
                        },

                        {
                            data: "FechaCierreFinal",
                            className: "text-center"
                        },

                        {
                            data: "DuracionInventario",
                            className: "text-center"
                        },

                        {
                            data: "Faltantes",
                            className: "text-center"
                        },
                        {
                            data: "Sobrantes",
                            className: "text-center"
                        },
                        {
                            data: "CodigoDeInventario",
                            className: "text-center",
                            orderable: false,
                            searchable: false,
                            render: function (data, type, row) {
                                if (!data) {
                                    return "-";
                                }
                                return `<button type="button"
                                                class="btn btn-success btn-sm btnExcelHistorial"
                                                data-cod-inventario="${data}">
                                            <i class="ti ti-file-download me-1"></i>
                                            Excel
                                        </button>`
                                ;
                            }
                        }
                    ],
                    //columnDefs: [
                    //    {
                    //        targets: '_all',
                    //        render: function (data) {
                    //            return data == null || data === "" ? "-" : data;
                    //        }
                    //    }
                    //],
                    columnDefs: [],

                    pageLength: 25,
                    searching: true,
                    "autoWidth": false,
                    dom:'lrtip',
                    language: españolTbl
                });

            }

            // Descargar reporte en excel
            async function ExportarExcel(cod_inv) {

                const obj = {
                    cod_inv: cod_inv
                };

                Swal.fire({
                    title: 'Generando Excel...',
                    html: 'Por favor espere',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                try {

                    const response = await fetch(
                        '@Url.Action("ExportarElHistorialDelInventarioPlantillaInicio", "Inventario")',
                        {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify(obj)
                        }
                    );

                    if (!response.ok) {
                        throw new Error('No se pudo generar el archivo Excel.');
                    }

                    // Obtener archivo
                    const blob = await response.blob();

                    // Crear URL temporal
                    const url = window.URL.createObjectURL(blob);

                    // Crear enlace de descarga
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `Inventario_Original_${obj.cod_inv}.xlsx`;

                    document.body.appendChild(a);
                    a.click();

                    // Limpiar
                    a.remove();
                    window.URL.revokeObjectURL(url);

                    Swal.close();

                } catch (error) {

                    console.error(error);

                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: error.message || 'Ocurrió un error al generar el Excel.'
                    });
                }
            }
    </script>
}