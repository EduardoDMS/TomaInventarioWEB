                            className: "text-center"
                        },

                        {
                            data: "FechaInicio",
                            className: "text-center"
                        },

                        {
                            data: "FechaCierreFinal",
                            className: "text-center"
                        },

                        {
                            data: "DuracionInventario",
                            className: "text-center"
                        },

                        {
                            data: "Faltantes",
                            className: "text-center"
                        },
                        {
                            data: "Sobrantes",
                            className: "text-center"
                        },
                        {
                            data: "CodigoDeInventario",
                            className: "text-center",
                            orderable: false,
                            searchable: false,
                            render: function (data, type, row) {
                                if (!data) {
