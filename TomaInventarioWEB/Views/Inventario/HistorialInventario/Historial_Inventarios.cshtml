            // Descargar reporte en excel
            async function ExportarExcel(cod_inv) {

                //if (!inventarioSeleccionado.codigo) {
                //    Swal.fire({
                //        icon: 'warning',
                //        title: 'Atención',
                //        text: 'Debe seleccionar un inventario primero'
                //    });
                //    return;
                //}

                const obj = {
                    cod_inv: cod_inv
                };

                Swal.fire({
                    title: 'Generando Excel...',
                    html: 'Por favor espere',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                try {

                    const response = await fetch(
                        '@Url.Action("ExportarElHistorialDelInventarioPlantillaInicio", "Inventario")',
                        {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify(obj)
                        }
                    );

                    if (!response.ok) {
                        throw new Error('No se pudo generar el archivo Excel.');
                    }

                    // Obtener archivo
                    const blob = await response.blob();

                    // Crear URL temporal
                    const url = window.URL.createObjectURL(blob);

                    // Crear enlace de descarga
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `Inventario_Original_${obj.cod_inv}.xlsx`;

                    document.body.appendChild(a);
                    a.click();

                    // Limpiar
                    a.remove();
                    window.URL.revokeObjectURL(url);

                    Swal.close();

                } catch (error) {

                    console.error(error);

                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: error.message || 'Ocurrió un error al generar el Excel.'
                    });
                }
            }
