        function ExportExcelReport() {
            var url = '@Url.Content("~/")Inventario/ExportarExcel/';

            var radSelect = $('input:radio[name=listGroupReport]:checked').val();
            var filtro = new Object();

            filtro.tipoReporte = radSelect;
            filtro.Cod_inventario = $('#lblInventario').text();
            switch (radSelect) {
                case "0": filtro.DatoFiltro = $('#RangeReport1').val(); break;
                case "1": filtro.DatoFiltro = $('#txtCodProduct').val(); break;
                case "2": filtro.DatoFiltro = $('#txtCodUbicacion').val();
                    filtro.NConteo = $('#RangeReport3').val();
                    filtro.Usuario = $('#txtCodUsuario1').val();
                    break;
                case "3": filtro.DatoFiltro = $('#txtCodUsuario2').val(); break;
                default: //Console.log('Sin selección de reporte');; break;
            }

            if (radSelect != 2) { filtro.NConteo = ConteoActual; }
            if (radSelect != 2) { filtro.Usuario = ""; }
            filtro.inventario = $('#lblAlmacen').text();
            filtro.codigo = $('#lblInventario').text();
            /*toggle_Loadingtb('tbLoading', true);*/

            var xhr = new XMLHttpRequest();
            xhr.open('GET', url + '?fecha=' + filtro.fecha + '&tipoReporte=' + filtro.tipoReporte
                + '&Cod_inventario=' + filtro.Cod_inventario + '&DatoFiltro=' + filtro.DatoFiltro + '&NConteo=' + filtro.NConteo
                + '&Usuario=' + filtro.Usuario + '&inventario=' + filtro.inventario + '&codigo=' + filtro.codigo , true);
            xhr.responseType = 'blob'; // Indicar que esperamos una respuesta binaria
            // Cuando la solicitud esté completada
            xhr.onload = function () {
                // Crear un objeto Blob con la respuesta
                var blob = xhr.response;

                // Crear un enlace (link) en el DOM
                var downloadLink = document.createElement('a');
                downloadLink.href = window.URL.createObjectURL(blob);
              var titulo = "";
                switch (filtro.tipoReporte) {
                    case "0": titulo = "Reporte Diferencial Conteo - " + filtro.DatoFiltro; break;
                    case "1": titulo = "Reporte de Productos"; break;
                    case "2": titulo = "Reporte de Ubicaciones Conteo - " + filtro.NConteo; break;
                    case "3": titulo = "Reporte de Lecturas de Usuario"; break;
                }
                var _name = titulo
                downloadLink.download = _name + '.xlsx';

                // Hacer click en el enlace para descargar el archivo
                document.body.appendChild(downloadLink);
                downloadLink.click();

                // Una vez que se ha descargado el archivo, ocultar el indicador de carga
                /*toggle_Loadingtb('tbLoading', false);*/
            };
            // Enviar la solicitud
            xhr.send();


        }


