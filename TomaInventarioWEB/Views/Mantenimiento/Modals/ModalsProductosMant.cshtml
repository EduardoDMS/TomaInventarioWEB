@* Modal Agregar Producto *@
<div class="modal fade" id="Add_Modal" tabindex="-1" aria-labelledby="addProductoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <div>
                    <h5 class="modal-title fw-bold mb-1" id="addProductoLabel">
                        <i class="ti ti-package me-2 text-primary"></i>Nuevo Producto
                    </h5>
                    <p class="mb-0 text-muted fs-2">Registre un nuevo producto en el inventario</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body py-4">
                <div class="mb-4">
                    <label for="txtCod_add" class="form-label fw-semibold">
                        Código de Producto <span class="text-danger">*</span>
                    </label>
                    <div class="position-relative">
                        <input type="text"
                               class="form-control"
                               id="txtCod_add"
                               autocomplete="off"
                               placeholder="Ejemplo: PROD-001">
                        <div class="invalid-feedback">
                            El código del producto es obligatorio
                        </div>
                        <small class="form-text text-muted d-block mt-1">
                            <i class="ti ti-info-circle fs-4"></i> Código único para identificar el producto
                        </small>
                    </div>
                </div>

                <div class="mb-4">
                    <label for="txtProducto_add" class="form-label fw-semibold">
                        Descripción del Producto <span class="text-danger">*</span>
                    </label>
                    <div class="position-relative">
                        <input type="text"
                               class="form-control"
                               id="txtProducto_add"
                               autocomplete="off"
                               placeholder="Ingrese la descripción del producto">
                        <div class="invalid-feedback">
                            La descripción del producto es obligatoria
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="cbxUM_add" class="form-label fw-semibold">
                        Unidad de Medida
                    </label>
                    <div class="position-relative">
                        @Html.DropDownList("cbxUM_add", new SelectList(ViewBag.ListaUM, "intValue", "vchdesc"), new { @Class = "form-select" })
                        <small class="form-text text-muted d-block mt-1">
                            <i class="ti ti-info-circle fs-4"></i> Unidad en la que se medirá el producto (Ej: Unidades, Kg, Litros)
                        </small>
                    </div>
                </div>

                <div class="mb-4">
                    <label for="txtCosto_add" class="form-label fw-semibold">
                        Colocar el valor del producto <span class="text-danger">*</span>
                    </label>
                    <div class="position-relative">
                        <input type="text"
                               class="form-control"
                               id="txtCosto_add"
                               autocomplete="off"
                               placeholder="Ingrese el monto del producto">
                        <div class="invalid-feedback">
                            averiguar si era obligatoria xd
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label for="cbxMon_add" class="form-label fw-semibold">
                        Tipo de moneda
                    </label>
                    <div class="position-relative">
                        @Html.DropDownList("cbxMon_add", new SelectList(ViewBag.listMon, "intValue", "vchdesc"), new { @Class = "form-select" })
                        <small class="form-text text-muted d-block mt-1">
                            <i class="ti ti-info-circle fs-4"></i> Tipo de cambio que tendra el coste del producto
                        </small>
                    </div>
                </div>

            </div>

            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                    <i class="ti ti-x me-1 fs-4"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="btn_Add">
                    <i class="ti ti-check me-1 fs-4"></i>Guardar Producto
                </button>
            </div>
        </div>
    </div>
</div>

@* Modal Editar Producto *@
<div class="modal fade" id="Edit_Modal" tabindex="-1" aria-labelledby="editProductoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <div>
                    <h5 class="modal-title fw-bold mb-1" id="editProductoLabel">
                        <i class="ti ti-edit me-2 text-primary"></i>Editar Producto
                    </h5>
                    <p class="mb-0 text-muted fs-2">Actualice la información del producto</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body py-4">
                <div class="mb-4">
                    <label for="txtCod_edit" class="form-label fw-semibold">
                        Código de Producto
                    </label>
                    <input type="text"
                           class="form-control bg-light"
                           id="txtCod_edit"
                           autocomplete="off"
                           disabled
                           readonly>
                    <small class="form-text text-muted d-block mt-1">
                        <i class="ti ti-lock fs-4"></i> El código del producto no se puede modificar
                    </small>
                </div>

                <div class="mb-4">
                    <label for="txtProducto_edit" class="form-label fw-semibold">
                        Descripción del Producto <span class="text-danger">*</span>
                    </label>
                    <div class="position-relative">
                        <input type="text"
                               class="form-control"
                               id="txtProducto_edit"
                               autocomplete="off"
                               placeholder="Ingrese la descripción del producto">
                        <div class="invalid-feedback">
                            La descripción del producto es obligatoria
                        </div>
                    </div>

                </div>

                <div class="mb-4">
                    <label for="cbxUM_edit" class="form-label fw-semibold">
                        <i class="ti ti-ruler-measure fs-4 me-1"></i>Unidad de Medida <span class="text-danger">*</span>
                    </label>
                    <div class="position-relative">
                        @Html.DropDownList("cbxUM_edit", new SelectList(ViewBag.ListaUM, "intValue", "vchdesc"), new { @Class = "form-select" })
                        <div class="invalid-feedback">
                            Debe seleccionar una unidad de medida
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label for="txtCosto_edit" class="form-label fw-semibold">
                        Colocar el nuevo valor monetario del producto <span class="text-danger">*</span>
                    </label>
                    <div class="position-relative">
                        <input type="text"
                               class="form-control"
                               id="txtCosto_edit"
                               autocomplete="off"
                               placeholder="Ingrese el monto del producto">
                        <div class="invalid-feedback">
                            averiguar si era obligatoria xd
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label for="cbxMon_edit" class="form-label fw-semibold">
                        <i class="ti ti-ruler-measure fs-4 me-1"></i>TipoMonedas <span class="text-danger">*</span>
                    </label>
                    <div class="position-relative">
                        @Html.DropDownList("cbxMon_edit", new SelectList(ViewBag.listMon, "intValue", "vchdesc"), new { @Class = "form-select" })
                        <div class="invalid-feedback">
                            Debe Seleccionar un valor determinado a dar a su producto
                        </div>
                    </div>
                </div>


                <div class="mb-3">
                    <div class="card bg-light">
                        <div class="card-body p-3">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" id="chkActivo_edit" checked>
                                <label class="form-check-label fw-semibold" for="chkActivo_edit">
                                    Producto Activo
                                </label>
                                <small class="d-block text-muted mt-1">
                                    Desactive para ocultar el producto sin eliminarlo del sistema
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                    <i class="ti ti-x me-1 fs-4"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="btn_SaveEdit">
                    <i class="ti ti-device-floppy me-1 fs-4"></i>Guardar Cambios
                </button>
            </div>
        </div>
    </div>
</div>

@* Modal Importar Productos *@
<div class="modal fade" id="Import_Modal" tabindex="-1" aria-labelledby="importProductoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <div class="d-flex">
                    <div class="me-3">
                        <h5 class="modal-title fw-bold mb-1" id="importProductoLabel">
                            <i class="ti ti-file-import me-2 text-success"></i>Importar Productos
                        </h5>
                        <p class="mb-0 text-muted fs-2">Cargue múltiples productos desde un archivo Excel</p>
                    </div>
                    <a href="https://www.youtube.com/watch?v=K_NQiPc_9oI" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary d-flex align-items-center justify-content-center" id="videoInv">
                        ¿Necesitas ayuda?
                        <i class="ti ti-brand-youtube ms-1 fs-6"></i>
                    </a>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body py-4">
                <div class="mb-4">
                    <div class="d-flex align-items-start">
                        <div class="rounded-circle bg-light-primary d-flex align-items-center justify-content-center flex-shrink-0 me-3">
                            <span class="fw-bold text-primary fs-5">1</span>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="fw-semibold mb-2">Descargue la plantilla de Excel</h6>
                            <p class="text-muted mb-3 fs-2">
                                Utilice nuestra plantilla para asegurar que los datos estén en el formato correcto
                            </p>
                            <button id="btnTemplate" type="button" class="btn btn-success btn-sm">
                                <i class="ti ti-download me-1 fs-4"></i>Descargar Plantilla
                            </button>
                        </div>
                    </div>
                </div>

                <div class="border-top my-4"></div>

                <div class="mb-3">
                    <div class="d-flex align-items-start">
                        <div class="rounded-circle bg-light-primary d-flex align-items-center justify-content-center flex-shrink-0 me-3">
                            <span class="fw-bold text-primary fs-5">2</span>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="fw-semibold mb-2">Seleccione el archivo a importar</h6>
                            <p class="text-muted mb-3 fs-2">
                                Complete la plantilla con sus productos y cárguela aquí
                            </p>
                            <div class="mb-2">
                                <input class="form-control"
                                       id="fileInput"
                                       type="file"
                                       accept=".xlsx,.xls">
                                <div class="invalid-feedback">
                                    Por favor seleccione un archivo Excel válido
                                </div>
                            </div>
                            <small class="form-text text-muted">
                                <i class="ti ti-info-circle fs-4"></i> Formatos aceptados: .xlsx, .xls (máx. 5MB)
                            </small>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info d-flex align-items-start mt-4" role="alert">
                    <i class="ti ti-info-circle me-2 fs-5 flex-shrink-0"></i>
                    <div>
                        <strong>Consejos para una importación exitosa:</strong>
                        <ul class="mb-0 mt-2 ps-3">
                            <li class="small">Asegúrese de que todos los campos obligatorios estén completos</li>
                            <li class="small">Los códigos de producto deben ser únicos</li>
                            <li class="small">Verifique que las unidades de medida existan en el sistema</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                    <i class="ti ti-x me-1 fs-4"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="btn_Import">
                    <i class="ti ti-upload me-1 fs-4"></i>Importar Productos
                </button>
            </div>
        </div>
    </div>
</div>

@*Resultados de Importación*@

<div class="modal fade" id="RImport_modal" role="dialog" tabindex="-1" aria-labelledby="ttl_ImportModal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <i class="ti ti-package-import fs-5 text-primary"></i>
                    <div>
                        <h5 class="modal-title mb-0" id="ttl_ImportModal">Resultado de Importación de Productos</h5>
                        <small class="text-muted">Revisa el estado de cada producto procesado</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">

                <div class="d-flex justify-content-evenly gap-2 mb-4">
                    <!-- TOTAL DE PRODUCTOS NUEVAS (VERDE)-->
                    <div class="card text-bg-success">
                        <div class="card-body text-white p-2">
                            <div class="d-flex flex-row align-items-center">
                                <div class="ms-3">
                                    <h4 class="mb-0 text-white fs-6">Nuevos</h4>
                                </div>
                                <div class="mx-3">
                                    <h2 id="lblNuevos" class="fs-7 mb-0 text-white">
                                        6540
                                    </h2>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TOTAL DE PRODUCTOS ACTUALIZADAS (CELESTE)-->
                    <div class="card text-bg-info">
                        <div class="card-body text-white p-2">
                            <div class="d-flex flex-row align-items-center">
                                <div class="ms-3">
                                    <h4 class="mb-0 text-white fs-6">Actualizados</h4>
                                </div>
                                <div class="mx-3">
                                    <h2 id="lblActualizados" class="fs-7 mb-0 text-white">
                                        6540
                                    </h2>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TOTAL DE PRODUCTOS ERRONEAS (ROJO)-->
                    <div class="card text-bg-danger">
                        <div class="card-body text-white p-2">
                            <div class="d-flex flex-row align-items-center">
                                <div class="ms-3">
                                    <h4 class="mb-0 text-white fs-6">Erróneos</h4>
                                </div>
                                <div class="mx-3">
                                    <h2 id="lblErrores" class="fs-7 mb-0 text-white">
                                        6540
                                    </h2>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TOTAL DE PRODUCTOS SIN CAMBIOS (GRIS)-->
                    <div class="card text-bg-muted">
                        <div class="card-body text-white p-2">
                            <div class="d-flex flex-row align-items-center">
                                <div class="ms-3">
                                    <h4 class="mb-0 text-white fs-6">Sin cambios</h4>
                                </div>
                                <div class="mx-3">
                                    <h2 id="lblSinCambios" class="fs-7 mb-0 text-white">
                                        6540
                                    </h2>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>



                <div class="d-flex align-items-start mb-3" role="alert">
                    <i class="ti ti-info-circle fs-5 me-2"></i>
                    <div>
                        @*<strong>Importante:</strong> La siguiente <u>tabla muestra solo los productos actualizados y los erróneos</u> estaran resaltados en <span class="text-danger fw-semibold">rojo</span>.
                            Revisa la columna "Mensaje" para conocer el motivo del error y corrige tu archivo Excel antes de importar nuevamente.*@
                        <strong>La siguiente tabla solo muestra los productos <span class="text-info fw-semibold">actualizados</span> y <span class="text-danger fw-semibold">erróneos</span>.</strong>
                    </div>
                </div>

                <div class="table-responsive">
                    <table id="RImport_Tbl" class="table table-hover align-middle w-100">
                        <thead class="table-light">
                            <tr></tr>
                        </thead>
                        <tbody>
                            <tr></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="modal-footer border-top bg-light">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
                    <i class="ti ti-check me-1"></i>Entendido
                </button>
            </div>
        </div>
    </div>
</div>



@* Modal Actualizar Productos x Precios *@
<div class="modal fade" id="ImportxProdxCosto_Modal" tabindex="-1" aria-labelledby="importCostoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <div class="d-flex">
                    <div class="me-3">
                        <h5 class="modal-title fw-bold mb-1" id="importCostoLabel">
                            <i class="ti ti-file-import me-2 text-success"></i>Actualizar Precios de Productos
                        </h5>
                        <p class="mb-0 text-muted fs-2">Actualice el costo y moneda de productos existentes desde un archivo Excel</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body py-4">
                <div class="mb-4">
                    <div class="d-flex align-items-start">
                        <div class="rounded-circle bg-light-primary d-flex align-items-center justify-content-center flex-shrink-0 me-3">
                            <span class="fw-bold text-primary fs-5">1</span>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="fw-semibold mb-2">Descargue la plantilla de Excel</h6>
                            <p class="text-muted mb-3 fs-2">Solo necesita: código del producto, precio de costo y código de moneda</p>
                            <button id="btnTemplateCosto" type="button" class="btn btn-success btn-sm">
                                <i class="ti ti-download me-1 fs-4"></i>Descargar Plantilla
                            </button>
                        </div>
                    </div>
                </div>

                <div class="border-top my-4"></div>

                <div class="mb-3">
                    <div class="d-flex align-items-start">
                        <div class="rounded-circle bg-light-primary d-flex align-items-center justify-content-center flex-shrink-0 me-3">
                            <span class="fw-bold text-primary fs-5">2</span>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="fw-semibold mb-2">Seleccione el archivo a importar</h6>
                            <div class="mb-2">
                                <input class="form-control" id="fileInputCosto" type="file" accept=".xlsx,.xls">
                                <div class="invalid-feedback">Por favor seleccione un archivo Excel válido</div>
                            </div>
                            <small class="form-text text-muted">
                                <i class="ti ti-info-circle fs-4"></i> Formatos aceptados: .xlsx, .xls (máx. 5MB)
                            </small>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info d-flex align-items-start mt-4" role="alert">
                    <i class="ti ti-info-circle me-2 fs-5 flex-shrink-0"></i>
                    <div>
                        <strong>Consejos:</strong>
                        <ul class="mb-0 mt-2 ps-3">
                            <li class="small">Solo se actualizan productos que ya existen — este proceso NO crea productos nuevos</li>
                            <li class="small">Verifique que los precios sean numéricos y el código de moneda exista</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                    <i class="ti ti-x me-1 fs-4"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="btn_ImportCosto">
                    <i class="ti ti-upload me-1 fs-4"></i>Actualizar Precios
                </button>
            </div>
        </div>
    </div>
</div>

