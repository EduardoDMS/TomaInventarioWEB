@*Modal de agregar TipoMoneda*@
<div class="modal fade" id="Add_TipoMoneda" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header border-bottom">
                <div>
                    <h1 class="modal-title fs-4 fw-bold mb-1" id="exampleModalLabel">
                        <i class="ti ti-building-warehouse me-2"></i>Agregar Moneda
                    </h1>
                    <p class="text-muted small mb-0">Complete la información del nuevo tipo de cambio</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <div class="row g-3">
                    <div class="col-12">
                        <div class="input-wrapper">
                            <label for="txtCodMoneda_add" class="input-label form-label fw-semibold mb-2">
                                Código de Moneda <span class="text-danger">*</span>
                            </label>
                            <div class="position-relative">
                                <input type="text" class="form-control" id="txtCodMoneda_add"
                                       autocomplete="off" maxlength="20" placeholder="Ej: PEN">
                                <small class="form-text text-muted">Máximo 20 caracteres</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="input-wrapper">
                            <label for="txtDscMoneda_add" class="input-label form-label fw-semibold mb-2">
                                Descripción de Moneda <span class="text-danger">*</span>
                            </label>
                            <div class="position-relative">
                                <input type="text" class="form-control" id="txtDscMoneda_add"
                                       autocomplete="off" maxlength="200" placeholder="Ej: Soles">
                                <small class="form-text text-muted">Máximo 200 caracteres</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top">
                <div class="Modal_content_mensajes w-100 mb-2" id="content_mensajes"></div>
                <div class="d-flex gap-2 w-100 justify-content-end">
                    <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">
                        <i class="ti ti-x me-1"></i>Cancelar
                    </button>
                    <button type="button" class="btn btn-primary px-4" id="btn_Add">
                        <i class="ti ti-device-floppy me-1"></i>Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@* Modal Editar Moneda *@
<div class="modal fade" id="Edit_Moneda" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header border-bottom pb-3">
                <div>
                    <h1 class="modal-title fs-4 fw-bold mb-1" id="exampleModalLabel">
                        <i class="ti ti-edit me-2"></i>Editar Moneda
                    </h1>
                    <p class="text-muted small mb-0">Modifique la información de su Moneda</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-0">
                <div class="row g-3">
                    <div class="col-12">
                        <div class="input-wrapper">
                            <label for="txtcodMoneda_edit" class="select-label form-label fw-semibold mb-2">
                                Código de Moneda
                            </label>
                            <input type="text" class="form-control bg-light" id="txtcodMoneda_edit"
                                   autocomplete="off" disabled>
                            <small class="form-text text-muted">El código no puede ser modificado</small>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="input-wrapper">
                            <label for="txtdscMoneda_edit" class="input-label form-label fw-semibold mb-2">
                                Descripción de la moneda <span class="text-danger">*</span>
                            </label>
                            <div class="position-relative">
                                <input type="text" class="form-control" id="txtdscMoneda_edit"
                                       autocomplete="off" placeholder="Ingrese la descripción">
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="input-wrapper mt-2">
                            <div class="card border-0 bg-light p-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch"
                                           id="chkActivo_edit" checked>
                                    <label class="form-check-label fw-semibold ms-2" for="chkActivo_edit">
                                        <i class="bi bi-check-circle me-1"></i>Moneda activada
                                    </label>
                                </div>
                                <small class="text-muted mt-2 ms-5">
                                    Desactive si ya no planea usar este valor de moneda en sus productos
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-3">
                <div class="Modal_content_mensajes w-100 mb-2" id="content_mensajes2"></div>
                <div class="d-flex gap-2 w-100 justify-content-end">
                    <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">
                        <i class="ti ti-x me-1"></i>Cancelar
                    </button>
                    <button type="button" class="btn btn-primary px-4" id="btn_SaveEdit">
                        <i class="ti ti-device-floppy me-1"></i>Guardar Cambios
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>