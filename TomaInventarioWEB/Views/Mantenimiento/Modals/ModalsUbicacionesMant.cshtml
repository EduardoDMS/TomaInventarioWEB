@* Modal Agregar Ubicación *@
<div class="modal fade" id="Add_ubicacion" tabindex="-1" aria-labelledby="addUbicacionLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <div>
                    <h5 class="modal-title fw-bold mb-1" id="addUbicacionLabel">
                        <i class="ti ti-map-pin me-2 text-primary"></i>Nueva Ubicación
                    </h5>
                    <p class="mb-0 text-muted fs-2">Registre una nueva ubicación dentro del almacén</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body py-4">
                <div class="mb-4">
                    <label for="txtCodUbicacion_add" class="form-label fw-semibold">
                        Código de Ubicación <span class="text-danger">*</span>
                    </label>
                    <div class="position-relative">
                        <input type="text"
                               class="form-control"
                               id="txtCodUbicacion_add"
                               autocomplete="off"
                               maxlength="20"
                               placeholder="Ejemplo: A-01-001">
                        <div class="invalid-feedback">
                            El código de ubicación es obligatorio
                        </div>
                        <small class="form-text text-muted d-block mt-1">
                            <i class="ti ti-info-circle fs-4"></i> Máximo 20 caracteres - Use un formato claro (Ej: Pasillo-Rack-Nivel)
                        </small>
                    </div>                  
                </div>

                <div class="mb-4">
                    <label for="txtDscUbicacion_add" class="form-label fw-semibold">
                        Descripción de la Ubicación <span class="text-danger">*</span>
                    </label>
                    <div class="position-relative">
                        <input type="text"
                               class="form-control"
                               id="txtDscUbicacion_add"
                               autocomplete="off"
                               maxlength="200"
                               placeholder="Ejemplo: Pasillo A - Rack 1 - Nivel Superior">
                        <div class="invalid-feedback">
                            La descripción es obligatoria
                        </div>
                        <small class="form-text text-muted d-block mt-1">
                            <i class="ti ti-info-circle fs-4"></i> Máximo 200 caracteres - Sea descriptivo para facilitar la identificación
                        </small>
                    </div>              
                </div>

                <div class="alert alert-warning d-flex align-items-start mb-4 d-none" role="alert" id="txtUbicacion_add">
                    <i class="ti ti-alert-triangle me-2 fs-5 flex-shrink-0"></i>
                    <div>
                        <strong>Almacén requerido</strong><br>
                        <small>Debe crear al menos un almacén antes de agregar ubicaciones.</small><br>
                        <a href="@Url.Action("AlmacenesMant", "Mantenimiento")" class="alert-link">
                            <i class="ti ti-plus fs-4"></i> Crear Almacén Ahora
                        </a>
                    </div>
                </div>

                <div id="Div_cbxUbicacion_add">
                    <label for="cbxUbicacion_add" class="form-label fw-semibold">
                        Almacén(es) Asignado(s) <span class="text-danger">*</span>
                    </label>
                    <div class="position-relative">
                        @Html.DropDownList(
                                               "cbxUbicacion_add",
                                               new SelectList(ViewBag.ListaAlmacenesModal, "intValue", "vchdesc"),
                                               new { @class = "form-select select2_M", multiple = "multiple" }
                                           )
                        <div class="invalid-feedback">
                            Debe seleccionar al menos un almacén
                        </div>
                        <small class="form-text text-muted d-block mt-1">
                            <i class="ti ti-info-circle fs-4"></i> Puede seleccionar múltiples almacenes para esta ubicación
                        </small>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                    <i class="ti ti-x me-1 fs-4"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="btn_Add">
                    <i class="ti ti-check me-1 fs-4"></i>Guardar Ubicación
                </button>
            </div>
        </div>
    </div>
</div>



@* Modal Editar Ubicación *@
<div class="modal fade" id="Edit_ubicacion" tabindex="-1" aria-labelledby="editUbicacionLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <div>
                    <h5 class="modal-title fw-bold mb-1" id="editUbicacionLabel">
                        <i class="ti ti-edit me-2 text-primary"></i>Editar Ubicación
                    </h5>
                    <p class="mb-0 text-muted fs-2">Actualice la información de la ubicación</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body py-4">
                <div class="mb-4">
                    <label for="txtCodUbicacion_edit" class="form-label fw-semibold">
                        Código de Ubicación
                    </label>
                    <input type="text"
                           class="form-control bg-light"
                           id="txtCodUbicacion_edit"
                           autocomplete="off"
                           maxlength="20"
                           disabled
                           readonly>
                    <small class="form-text text-muted d-block mt-1">
                        <i class="ti ti-lock fs-4"></i> El código de ubicación no se puede modificar
                    </small>
                </div>

                <div class="mb-4">
                    <label for="txtDscUbicacion_edit" class="form-label fw-semibold">
                        Descripción de la Ubicación <span class="text-danger">*</span>
                    </label>
                    <div class="position-relative">
                        <input type="text"
                               class="form-control"
                               id="txtDscUbicacion_edit"
                               autocomplete="off"
                               maxlength="200"
                               placeholder="Ingrese la descripción de la ubicación">
                        <div class="invalid-feedback">
                            La descripción es obligatoria
                        </div>
                    </div>
                </div>

                <div class="mb-4" id="Div_cbxUbicacion_edit">
                    <label for="cbxUbicacion_edit" class="form-label fw-semibold ">
                        Almacén Asignado <span class="text-danger">*</span>
                    </label>
                    <div class="position-relative">
                        @Html.DropDownList("cbxUbicacion_edit", new SelectList(ViewBag.ListaAlmacenesModal, "intValue", "vchdesc"), "-- Seleccione un almacén --", new { @Class = "form-select select2_M" })
                        <div class="invalid-feedback">
                            Debe seleccionar un almacén
                        </div>
                    </div>                   
                </div>

                <div class="mb-3">
                    <div class="card border-0 bg-light">
                        <div class="card-body p-3">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" id="chkActivo_edit" checked>
                                <label class="form-check-label fw-semibold" for="chkActivo_edit">
                                    Ubicación Activa
                                </label>
                                <small class="d-block text-muted mt-1">
                                    Las ubicaciones inactivas no estarán disponibles para nuevos registros
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                    <i class="ti ti-x me-1 fs-4"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="btn_SaveEdit">
                    <i class="ti ti-device-floppy me-1 fs-4"></i>Guardar Cambios
                </button>
            </div>
        </div>
    </div>
</div>

@* Modal Importar Ubicaciones *@
<div class="modal fade" id="Import_Modal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <div class="d-flex">
                    <div class="me-3">
                        <h5 class="modal-title fw-bold mb-1" id="importModalLabel">
                            <i class="ti ti-file-import me-2 text-success"></i>Importar Ubicaciones
                        </h5>
                        <p class="mb-0 text-muted fs-2">Cargue múltiples ubicaciones desde un archivo Excel</p>
                    </div>       
                    <a href="https://www.youtube.com/watch?v=U5ccn1kuRHA" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary d-flex align-items-center justify-content-center" id="videoInv">
                        ¿Necesitas ayuda?
                        <i class="ti ti-brand-youtube ms-1 fs-6"></i>
                    </a>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body py-4">
                <div class="mb-4">
                    <div class="d-flex align-items-start">
                        <div class="rounded-circle bg-light-primary d-flex align-items-center justify-content-center flex-shrink-0 me-3">
                            <span class="fw-bold text-primary fs-5">1</span>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="fw-semibold mb-2">Descargue la plantilla de Excel</h6>
                            <p class="text-muted mb-3 fs-2">
                                Utilice nuestra plantilla para asegurar el formato correcto de los datos
                            </p>
                            <button id="btnTemplate" type="button" class="btn btn-success btn-sm">
                                <i class="ti ti-download me-1 fs-4"></i>Descargar Plantilla
                            </button>
                        </div>
                    </div>
                </div>

                <div class="border-top my-4"></div>

                <div class="mb-3">
                    <div class="d-flex align-items-start">
                        <div class="rounded-circle bg-light-primary d-flex align-items-center justify-content-center flex-shrink-0 me-3">
                            <span class="fw-bold text-primary fs-5">2</span>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="fw-semibold mb-2">Seleccione el archivo a importar</h6>
                            <p class="text-muted mb-3 fs-2">
                                Complete la plantilla con las ubicaciones y cárguela aquí
                            </p>
                            <div class="mb-2">
                                <input class="form-control"
                                       id="fileInput"
                                       type="file"
                                       accept=".xlsx,.xls">
                                <div class="invalid-feedback">
                                    Por favor seleccione un archivo Excel válido
                                </div>
                                <small class="form-text text-muted">
                                    <i class="ti ti-info-circle fs-4"></i> Formatos aceptados: .xlsx, .xls (máx. 5MB)
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info d-flex align-items-start mt-4" role="alert">
                    <i class="ti ti-info-circle me-2 fs-5 flex-shrink-0"></i>
                    <div>
                        <strong>Consejos para una importación exitosa:</strong>
                        <ul class="mb-0 mt-2 ps-3">
                            <li class="small">Asegúrese de que todos los campos obligatorios estén completos</li>
                            <li class="small">Los códigos de las ubicaciones deben ser únicos</li>
                            <li class="small">Verifique que el código de almacen exista en el sistema</li>
                        </ul>
                        @*<p class="small mb-0 mt-2">
                            <strong>Ejemplo:</strong> ALM-01-001 | Pasillo A - Rack 1 - Nivel Superior | Almacén Central
                        </p>*@
                    </div>
                </div>
            </div>

            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                    <i class="ti ti-x me-1 fs-4"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="btn_Import">
                    <i class="ti ti-upload me-1 fs-4"></i>Importar Ubicaciones
                </button>
            </div>
        </div>
    </div>
</div>



@*MODAL RESULT_IMPORT *@
<div class="modal fade" id="RImport_modal" tabindex="-1" aria-labelledby="ttl_ImportModal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <i class="ti ti-file-import fs-5"></i>
                    <div>
                        <h5 class="modal-title mb-0" id="ttl_ImportModal">Resultado de Importación</h5>
                        <small class="text-muted">Revisa el estado de cada registro procesado</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <div class="alert alert-info d-flex align-items-start mb-4" role="alert">
                    <i class="ti ti-info-circle fs-5 me-2"></i>
                    <div>
                        <strong>Tip:</strong> Los registros con errores están resaltados en rojo.
                        Revisa la columna "Mensaje" para conocer el motivo del error y corrige tu archivo Excel.
                    </div>
                </div>

                <div class="table-responsive">
                    <table id="RImport_Tbl" class="table table-hover align-middle w-100">
                        <thead>
                            <tr></tr>
                        </thead>
                        <tbody>
                            <tr></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="modal-footer border-top">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
                    <i class="ti ti-check me-1"></i>Entendido
                </button>
            </div>
        </div>
    </div>
</div>