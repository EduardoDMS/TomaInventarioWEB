@* Modal Agregar Unidad de Medida *@
<div class="modal fade" id="Add_Modal" tabindex="-1" aria-labelledby="addUMLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <div>
                    <h5 class="modal-title fw-bold mb-1" id="addUMLabel">
                        <i class="ti ti-ruler-measure me-2 text-primary"></i>Nueva Unidad de Medida
                    </h5>
                    <p class="mb-0 text-muted fs-2">Registre una nueva unidad de medida en el sistema</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body py-4">
                <div class="mb-4">
                    <label for="txtCod_add" class="form-label fw-semibold">
                        Código <span class="text-danger">*</span>
                    </label>
                    <div class="position-relative">
                        <input type="text"
                               class="form-control"
                               id="txtCod_add"
                               autocomplete="off"
                               placeholder="Ejemplo: KG, LT, UND">
                        <div class="invalid-feedback">
                            El código es obligatorio
                        </div>
                        <small class="form-text text-muted d-block mt-1">
                            <i class="ti ti-info-circle fs-4"></i> Código único de 2-4 caracteres
                        </small>
                    </div>                   
                </div>

                <div class="mb-4">
                    <label for="txtDsc_add" class="form-label fw-semibold">
                       Descripción <span class="text-danger">*</span>
                    </label>
                    <div class="position-relative">
                        <input type="text"
                               class="form-control"
                               id="txtDsc_add"
                               autocomplete="off"
                               placeholder="Ejemplo: Kilogramo, Litro, Unidad">
                        <div class="invalid-feedback">
                            La descripción es obligatoria
                        </div>
                        <small class="form-text text-muted d-block mt-1">
                            <i class="ti ti-info-circle fs-4"></i> Nombre completo de la unidad de medida
                        </small>
                    </div>                 
                </div>

                <div class="mb-3">
                    <label for="txtCantidad_add" class="form-label fw-semibold">
                        Valor de Conversión <span class="text-danger">*</span>
                    </label>
                    <div class="position-relative">
                        <input type="number"
                               class="form-control"
                               id="txtCantidad_add"
                               value="1"
                               step="1"
                               min="1"
                               placeholder="1">
                        <div class="invalid-feedback">
                            El valor debe ser mayor a 0
                        </div>
                        <small class="form-text text-muted d-block mt-1">
                            <i class="ti ti-info-circle fs-4"></i> Factor de conversión con respecto a la unidad base (normalmente 1)
                        </small>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                    <i class="ti ti-x me-1 fs-4"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="btn_Add">
                    <i class="ti ti-check me-1 fs-4"></i>Guardar Unidad
                </button>
            </div>
        </div>
    </div>
</div>





@* Modal Editar Unidad de Medida *@
<div class="modal fade" id="Edit_Modal" tabindex="-1" aria-labelledby="editUMLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <div>
                    <h5 class="modal-title fw-bold mb-1" id="editUMLabel">
                        <i class="ti ti-edit me-2 text-primary"></i>Editar Unidad de Medida
                    </h5>
                    <p class="mb-0 text-muted fs-2">Actualice la información de la unidad de medida</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body py-4">
                <div class="mb-4">
                    <label for="txtCod_edit" class="form-label fw-semibold">
                       Código
                    </label>
                    <input type="text"
                           class="form-control bg-light"
                           id="txtCod_edit"
                           autocomplete="off"
                           disabled
                           readonly>
                    <small class="form-text text-muted d-block mt-1">
                        <i class="ti ti-lock fs-4"></i> El código no se puede modificar
                    </small>
                </div>

                <div class="mb-4">
                    <label for="txtDsc_edit" class="form-label fw-semibold">
                       Descripción <span class="text-danger">*</span>
                    </label>
                    <div class="position-relative">
                        <input type="text"
                               class="form-control"
                               id="txtDsc_edit"
                               autocomplete="off"
                               placeholder="Ejemplo: Kilogramo, Litro, Unidad">
                        <div class="invalid-feedback">
                            La descripción es obligatoria
                        </div>
                    </div>
                    
                </div>

                <div class="mb-4">
                    <label for="txtCantidad_edit" class="form-label fw-semibold">
                        Valor de Conversión <span class="text-danger">*</span>
                    </label>
                    <div class="position-relative">
                        <input type="number"
                               class="form-control"
                               id="txtCantidad_edit"
                               value="1"
                               step="1"
                               min="1"
                               placeholder="1">
                        <div class="invalid-feedback">
                            El valor debe ser mayor a 0
                        </div>
                        <small class="form-text text-muted d-block mt-1">
                            <i class="ti ti-info-circle fs-4"></i> Factor de conversión con respecto a la unidad base
                        </small>
                    </div>                 
                </div>

                <div class="mb-3">
                    <div class="card bg-light">
                        <div class="card-body p-3">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" id="chkActivo_edit" checked>
                                <label class="form-check-label fw-semibold" for="chkActivo_edit">
                                    Unidad de Medida Activa
                                </label>
                                <small class="d-block text-muted mt-1">
                                    Desactive para ocultar esta unidad sin eliminarla del sistema
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                    <i class="ti ti-x me-1 fs-4"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="btn_SaveEdit">
                    <i class="ti ti-device-floppy me-1 fs-4"></i>Guardar Cambios
                </button>
            </div>
        </div>
    </div>
</div>




