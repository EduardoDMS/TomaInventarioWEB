
@{
    ViewBag.Title = "TipoMonedaMant";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string nonce = (string)HttpContext.Current.Items["ScriptNonce"];
}

@*<link href="~/Content/matdash/css/fonts.css" rel="stylesheet" />
    <link href="~/Content/matdash/css/styles.css" rel="stylesheet" />*@
@*<link href="~/Content/matdash/libs/sweetalert2/dist/sweetalert2.min.css" rel="stylesheet">*@
@*<link href="~/Content/matdash/libs/datatables.net-bs5/css/dataTables.bootstrap5.min.css" rel="stylesheet">*@


<div class="card">
    <div class="card-header bg-primary text-white">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h5 class="mb-0 fw-semibold text-white">Gestión de tipos de moneda </h5>
                <small class="opacity-75">Organice sus monedas</small>
            </div>


            <div class="d-flex gap-2">
                @*<button class="btn btn-warning d-none" id="Api_Almacen">
                        <i class="ti ti-cloud-upload me-2"></i>Cargar Almacenes de la nube
                    </button>*@
                <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#Add_TipoMoneda">
                    <i class="ti ti-plus me-2"></i>Agregar
                </button>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label fw-semibold">
                    <i class="ti ti-report-money me-1"></i>Moneda
                </label>
                <input type="text" class="form-control" id="txtMoneda" maxlength="20" placeholder="Buscar Moneda..." />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">
                    <i class="ti ti-toggle-right me-1"></i>Estado
                </label>
                <select class="form-select" id="cbxActivo">
                    <option value="">Todos</option>
                    <option value="1">Activo</option>
                    <option value="0">Inactivo</option>
                </select>
            </div>
            <div class="col-md-5 d-flex align-items-end gap-2">
                <button id="btn_filtrar" class="btn btn-primary flex-fill">
                    <i class="ti ti-search me-2"></i>Buscar
                </button>
                <button id="btn_limpiar" class="btn btn-outline-secondary flex-fill">
                    <i class="ti ti-eraser me-2"></i>Limpiar
                </button>
            </div>
        </div>
        <hr class="my-4">
        <div class="table-responsive">
            <table id="dtTabla" class="table table-striped table-hover w-100">
                <thead class="table-light">
                    <tr>
                        <th scope="col"><i class="ti ti-edit me-1"></i>Editar</th>
                        @*<th scope="col">idMoneda</th>*@
                        <th scope="col">Cod. Moneda</th>
                        <th scope="col">Desc. Moneda</th>
                        <th scope="col">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        @*<td class="d-none">Cargando...</td>*@
                        <td class="d-none">Cargando...</td>
                        <td class="d-none">Cargando...</td>
                        <td class="d-none">Cargando...</td>
                        <td class="d-none">Cargando...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@Html.Partial("~/Views/Mantenimiento/Modals/ModalsTipoMonedaMant.cshtml")

@section scripts{
    <script src="~/Assets/JS/MantenimientosJS/TipoMonedaMant/TipoMonedaTable.js"></script>
    <script src="~/Assets/JS/MantenimientosJS/TipoMonedaMant/TipoMonedaMantJS.js"></script>


    @*<script src="~/Content/matdash/libs/jquery-steps/build/jquery.steps.min.js"></script>
        <script src="~/Content/matdash/libs/jquery-validation/dist/jquery.validate.min.js"></script>*@
    @*<script src="~/Content/matdash/libs/sweetalert2/dist/sweetalert2.min.js"></script>*@

    @*<script src="~/Content/matdash/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>*@
    @*<script src="~/Content/matdash/libs/datatables.net/js/jquery.dataTables.min.js"></script>
        <script src="~/Content/matdash/js/datatable/datatable-api.init.js"></script>*@

}

