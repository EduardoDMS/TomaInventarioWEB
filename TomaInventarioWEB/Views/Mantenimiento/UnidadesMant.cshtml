<div class="card">
    <div class="card-header bg-primary text-white">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h5 class="mb-0 fw-semibold text-white"> Gestión de Unidades de Medidas</h5>
                <small class="opacity-75">Organice las unidades de medida</small>

            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#Add_Modal">
                    <i class="ti ti-plus"></i>Agregar 
                </button>
            </div>

        </div>
    </div>
    <div class="card-body">
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label fw-semibold"> 
                    <i class="ti ti-ruler-measure me-2"></i>Unidad de medida
                </label>
                <input type="text" class="form-control" id="txtDSC_UM" maxlength="200" placeholder="Buscar descripción..." />
            </div>
            <div class="col-md-5 d-flex align-items-end gap-2">
                <button id="btn_filtrar" class="btn btn-primary">
                    <i class="ti ti-search"></i> Buscar  
                </button>
                <button id="btn_limpiar" class="btn btn-outline-secondary">
                    <i class="ti ti-eraser me-2"></i>Limpiar
                </button>
            </div>
        </div>
        <hr class="my-4">

        <div class="table-responsive">
            <table id="dtTabla" class="table table-striped table-hover w-100">
                <thead class="table-light">
                    <tr>
                        <th scope="col"> Acciones</th>
                        <th scope="col">Cod. Unidad de Medida</th>
                        <th scope="col">Desc. Unidad de Medida</th>
                        <th scope="col">Estado</th>

                    </tr>
                <thead>
                <tbody>
                    <tr>
                        <td class="d-none">Cargando...</td>
                        <td class="d-none">Cargando...</td>
                        <td class="d-none">Cargando...</td>
                        <td class="d-none">Cargando...</td>
                    </tr>

                </tbody>
            </table>
        </div>

    </div>
</div>




@Html.Partial("~/Views/Mantenimiento/Modals/ModalsUnidadMedidaMant.cshtml")

