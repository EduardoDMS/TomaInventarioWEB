
@{
    ViewBag.Title = "UsuariosMant";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string nonce = (string)HttpContext.Current.Items["ScriptNonce"];
}

@*<link href="~/Content/matdash/css/fonts.css" rel="stylesheet" />
<link href="~/Content/matdash/css/styles.css" rel="stylesheet" />
<link href="~/Content/matdash/libs/sweetalert2/dist/sweetalert2.min.css" rel="stylesheet">
<link href="~/Content/matdash/libs/datatables.net-bs5/css/dataTables.bootstrap5.min.css" rel="stylesheet">*@


<div class="card">
    <div class="card-header bg-primary text-white">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h5 class="mb-0 fw-semibold text-white">Gestión de Usuarios</h5>
                <small class="opacity-75">Organice los usuarios</small>
            </div>
            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#Add_usuario">
                <i class="ti ti-plus"></i> Agregar 
            </button>
        </div>

    </div>
    <div class="card-body">
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label fw-semibold">
                    <i class="ti ti-user"></i>Usuario
                </label>
                <input type="text"
                       class="form-control"
                       id="txtUsuario"
                       maxlength="20"
                       placeholder="Buscar usuario..." />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">
                    <i class="ti ti-users"></i>Tipo de Usuario
                </label>
                <select class="form-select" id="cbxPerfil">
                    <option value="-1">Todos</option>
                    <option value="ADM">Administrador</option>
                    <option value="OPE">Operador</option>
                </select>
            </div>
            <div class="col-md-5 d-flex align-items-end gap-2">
                <button id="btn_filtrar" class="btn btn-primary flex-fill">
                    <i class="ti ti-search me-2"></i>Buscar
                </button>
                <button id="btn_limpiar" class="btn btn-outline-secondary flex-fill">
                    <i class="ti ti-eraser me-2"></i>Limpiar
                </button>
            </div>
        </div>


        <hr class="my-4">
        <div class="table-responsive">
            <table id="dtUsuario" class="table table-striped table-hover w-100">

                <thead class="table-light">
                    <tr>
                        <th scope="col">Acciones</th>
                        <th scope="col">Usuario</th>
                        <th scope="col">Perfil</th>
                        <th scope="col">Estado</th>

                    </tr>
                <thead>
                <tbody>
                    <tr>
                        <td class="d-none">Cargando...</td>
                        <td class="d-none">Cargando...</td>
                        <td class="d-none">Cargando...</td>
                        <td class="d-none">Cargando...</td>
                    </tr>

                </tbody>
            </table>
        </div>
    </div>
</div>




@Html.Partial("~/Views/Mantenimiento/Modals/ModalsUsuariosMant.cshtml")

@section scripts{

    <script src="~/Assets/JS/MantenimientosJS/UserMant/UsuariosMantJS.js"></script>
    <script src="~/Assets/JS/MantenimientosJS/UserMant/UserTable.js"></script>

    @*<script src="~/Content/matdash/libs/jquery-steps/build/jquery.steps.min.js"></script>
    <script src="~/Content/matdash/libs/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/Content/matdash/libs/sweetalert2/dist/sweetalert2.min.js"></script>
    <script src="~/Content/matdash/js/forms/sweet-alert.init.js"></script>*@

    @*<script src="~/Content/matdash/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>*@
    @*<script src="~/Content/matdash/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/Content/matdash/js/datatable/datatable-api.init.js"></script>*@
    <script src="~/Content/matdash/js/highlights/highlight.min.js"></script>
    <script nonce="@nonce">
        $(document).ready(function () {

            $('.select2_').select2({
                theme: 'bootstrap-5',
                width: '100%',
                height: '100%',
                multiple: true
            });

        });

    </script>

}

