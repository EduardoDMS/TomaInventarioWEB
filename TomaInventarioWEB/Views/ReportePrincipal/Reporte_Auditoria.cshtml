    function CargarTabla(datos, footerData) {   // <-- ahora recibe tambien el footer

        if ($.fn.DataTable.isDataTable('#tblReporteInventario')) {
            $('#tblReporteInventario').DataTable().destroy();
        }

        $('#tblReporteInventario tbody').empty();
        $('#filaFooterDinamica').empty(); // limpieza defensiva tambien aca

        let numerosConteo = [];

        datos.forEach(item => {
            if (!item.Conteos) return;
            item.Conteos.forEach(conteo => {
                if (!numerosConteo.includes(conteo.Nro_Conteo)) {
                    numerosConteo.push(conteo.Nro_Conteo);
                }
            });
        });
        numerosConteo.sort((a, b) => a - b);

        let columnas = [
            { data: "Codigo", title: "Código", className: "text-center" },
            { data: "Producto", title: "Producto", className: "text-center" },
            { data: "Stock_Inicial", title: "Stock Inicial", className: "text-center" },
            { data: "Ubicacion_Inicial", title: "Ubicación Inicial", className: "text-center" },
            { data: "Lote_Inicial", title: "Lote Inicial", className: "text-center" }
        ];

        numerosConteo.forEach(n => {
            columnas.push({
                data: null,
                title: `Conteo ${n}`,
                className: "text-center",
                render: function (data, type, row) {
                    if (!row.Conteos) return "";
                    const conteo = row.Conteos.find(x => x.Nro_Conteo === n);
                    if (!conteo) return "";
                    return `
                    <div class="text-start">
                        <div><strong>Stock:</strong> ${conteo.Stock_Contado ?? 0}</div>
                        <div><strong>Ubicación:</strong> ${conteo.Ubicaciones_Contadas || "-"}</div>
                        <div><strong>Lote:</strong> ${conteo.Lote_Contado || "-"}</div>
                        <div><strong>Usuario:</strong> ${conteo.Usuario || "-"}</div>
                        <div><strong>Hora:</strong> ${conteo.Hora_Registro || "-"}</div>
                    </div>
                `;
                }
            });
        });

        columnas.push(
            { data: "Stock_Final", title: "Stock Final", className: "text-center" },
            { data: "Diferencia", title: "Diferencia", className: "text-center" },
            { data: "Estado", title: "Estado", className: "text-center" }
        );

        let header = $('#tblReporteInventario thead tr');
        header.empty();
        columnas.forEach(columna => {
            header.append(`<th class="text-center">${columna.title}</th>`);
        });

        window._numerosConteoActual = numerosConteo;

        tblReporteInventario = $('#tblReporteInventario').DataTable({
            data: datos,
            columns: columnas,
            pageLength: 25,
            searching: true,
            dom: 'lrtip',
            language: españolTbl,
            // CLAVE: esto se ejecuta despues de CADA draw (init, busqueda, sort, pagina)
            // asi el footer se re-pinta siempre, sin importar que DataTables toque el DOM
            drawCallback: function (settings) {
                CargarFooterTabla(footerData, numerosConteo);
            }
        });
    }


    function CargarFooterTabla(footer, numerosConteo) {
        let fila = $('#filaFooterDinamica');
        fila.empty();

        if (!footer) {
            console.warn("Footer no recibido, revisa result.Entity.Footer en la respuesta");
            return;
        }

        numerosConteo = numerosConteo || [];

        fila.append(`<td colspan="2" class="fw-bolder">TOTALES</td>`);
        fila.append(`<td class="text-end fw-bold">${footer.StockInicialTotal ?? 0}</td>`);
        fila.append(`<td></td>`);
        fila.append(`<td></td>`);

        numerosConteo.forEach(n => {
            let totalConteo = (footer.TotalesPorConteo || []).find(t => t.Nro_ConteoTotal === n);
            let valor = totalConteo && totalConteo.Total_Stock != null ? totalConteo.Total_Stock : 0;
            fila.append(`<td class="text-end fw-bold">${valor}</td>`);
        });

        fila.append(`<td class="text-end fw-bold">${footer.StockFinalTotal ?? 0}</td>`);

        let diferencial = footer.StockDiferencial ?? 0;
        let clase = diferencial < 0 ? 'text-danger fw-bold' : 'text-success fw-bold';
        fila.append(`<td class="text-end"><span class="${clase}">${diferencial}</span></td>`);

        fila.append(`<td></td>`);
    }

        
        // Icono lock
        function CambiarIconoEstado(estado) {
            //console.log(estado);
            if (estado === "ABIERTO") {
                $("#estadoIcono")
                    .removeClass()
                    .addClass("round-40 rounded-circle text-white d-flex align-items-center justify-content-center text-bg-warning");

                $("#estadoIcono i")
                    .removeClass()
                    .addClass("ti ti-lock-open fs-6");
            }
            else {
                $("#estadoIcono")
                    .removeClass()
                    .addClass("round-40 rounded-circle text-white d-flex align-items-center justify-content-center text-bg-success");

                $("#estadoIcono i")
                    .removeClass()
                    .addClass("ti ti-lock fs-6");
            }
        }




        function exportarExcel() {
            if (!inventarioSeleccionado.codigo) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Atención',
                    text: 'Debe seleccionar un inventario primero'
                });
                return;
            }

            let busqueda = $('#customSearch').val() || '';

            Swal.fire({
                title: 'Generando Excel...',
                html: 'Por favor espere',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            let baseUrl = '@Url.Action("ExportarExcelReporteProducto", "ReportePrincipal")';
            let params = '?codInventario=' + encodeURIComponent(inventarioSeleccionado.codigo) +
                         '&busqueda=' + encodeURIComponent(busqueda);

            window.location.href = baseUrl + params;

            setTimeout(function() {
                Swal.close();
            }, 500);
        }

</script>
