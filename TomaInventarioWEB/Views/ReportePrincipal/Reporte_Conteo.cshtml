@{
    ViewBag.Title = "Reporte por Conteo";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string nonce = (string)HttpContext.Current.Items["ScriptNonce"];
}
@*<link href="~/Content/matdash/css/fonts.css" rel="stylesheet" />
<link href="~/Content/matdash/css/styles.css" rel="stylesheet" />
<link href="~/Content/matdash/libs/sweetalert2/dist/sweetalert2.min.css" rel="stylesheet">
<link href="~/Content/matdash/libs/datatables.net-bs5/css/dataTables.bootstrap5.min.css" rel="stylesheet">
<link href="~/Content/matdash/libs/select2/dist/css/select2.min.css" rel="stylesheet">*@

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-3 fw-semibold">
                    <i class="ti ti-clipboard-check me-2"></i>
                    Seleccionar Inventario para Reporte por Conteo
                </h5>

                <div class="row align-items-end">
                    <div class="col-md-12">
                        <label for="cbxInventariosCerrados" class="form-label fw-semibold">Inventario</label>
                        <select class="select2 form-control" id="cbxInventariosCerrados">
                            @foreach (var item in ViewBag.ListInventariosCerrados)
                            {
                                <option value="@item.vchValue">@item.vchdesc</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Reporte por Conteo -->
<div id="seccionReporte" class="row d-none">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0 fw-semibold text-white">
                    <i class="ti ti-numbers me-2"></i>REPORTE POR CONTEO
                </h5>
                <small class="text-white">Visualiza el reporte del conteo seleccionado</small>
            </div>

            <div class="card-body">
                <!-- Información del Inventario -->
                <div class="row mb-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-semibold mb-0">Información del Inventario</h6>
                        <span class="badge bg-info-subtle text-info" id="badgeEstadoConteo">-</span>
                    </div>
                    <div class="col-md-3">
                        <div class="hstack gap-3">
                            <span class="d-flex align-items-center justify-content-center round-48 bg-primary-subtle rounded">
                                <i class="ti ti-barcode fs-6 text-primary"></i>
                            </span>
                            <div>
                                <span class="text-muted">Inventario</span>
                                <h5 class="mt-1 fw-medium mb-0" id="txtResumenCodInventario">-</h5>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="hstack gap-3">
                            <span class="d-flex align-items-center justify-content-center round-48 bg-secondary-subtle rounded">
                                <i class="ti ti-building-warehouse fs-6 text-secondary"></i>
                            </span>
                            <div>
                                <span class="text-muted">Almacén</span>
                                <h5 class="mt-1 fw-medium mb-0" id="txtResumenNombreAlmacen">-</h5>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 col-lg">
                        <div class="hstack gap-3 mb-3 mb-md-0">
                            <span class="d-flex align-items-center justify-content-center round-48 bg-success-subtle rounded">
                                <i class="ti ti-numbers fs-6 text-success"></i>
                            </span>
                            <div>
                                <span class="text-muted">Conteo Actual</span>
                                <h5 class="mt-1 fw-medium mb-0" id="txtResumenConteoActual">0</h5>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 col-lg">
                        <div class="hstack gap-3 mb-3 mb-md-0">
                            <span class="d-flex align-items-center justify-content-center round-48 bg-warning-subtle rounded">
                                <i class="ti ti-numbers fs-6 text-warning"></i>
                            </span>
                            <div>
                                <span class="text-muted">Último Conteo Finalizado</span>
                                <h5 class="mt-1 fw-medium mb-0" id="txtResumenUltimoConteo">-</h5>
                            </div>
                        </div>
                    </div>

                    @*<div class="col-md-3">
            <div class="hstack gap-3">
                <span class="d-flex align-items-center justify-content-center round-48 bg-success-subtle rounded">
                    <i class="ti ti-numbers fs-6 text-success"></i>
                </span>
                <div>
                    <span class="text-muted">Conteo Seleccionado</span>
                    <h5 class="mt-1 fw-medium mb-0" id="txtResumenNroConteo">-</h5>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="hstack gap-3">
                <span class="d-flex align-items-center justify-content-center round-48 bg-info-subtle rounded">
                    <i class="ti ti-calendar-check fs-6 text-info"></i>
                </span>
                <div>
                    <span class="text-muted">Fecha Registro</span>
                    <h5 class="mt-1 fw-medium mb-0" id="txtResumenFechaRegistro">-</h5>
                </div>
            </div>
        </div>*@
                </div>

                <hr class="my-4">

                <!-- Selector de Conteo y Exportar -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label for="cbxConteoSelector" class="form-label fw-semibold">
                            <i class="ti ti-numbers me-1"></i>Seleccionar Conteo
                        </label>
                        <select class="form-control" id="cbxConteoSelector">
                            <option value="1">Conteo 1</option>
                            <option value="2">Conteo 2</option>
                            <option value="3">Conteo 3</option>
                        </select>
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <button type="button" class="btn btn-success" id="btnExportarExcel">
                            <i class="ti ti-file-download me-1"></i> Exportar a Excel
                        </button>
                    </div>
                </div>

                <!-- Tabla -->
                <div class="table-responsive">
                    <table id="tblReportePorConteo" class="table table-hover table-bordered align-middle text-nowrap mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Código</th>
                                <th>Producto</th>
                                <th>Ubicación</th>
                                <th>Lote</th>
                                @*<th>Serie</th>*@
                                <th class="text-end">Stock Inicial</th>
                                <th class="text-center">Conteo #</th>
                                <th class="text-end">Stock Conteo</th>
                                <th class="text-end">Diferencial</th>
                                <th>Usuario</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                        <tfoot class="table-secondary fw-bold">
                            <tr>
                                <td colspan="4" class="text-end">TOTALES:</td>
                                <td class="text-end" id="footerStockInicial">0</td>
                                <td class="text-center">-</td>
                                <td class="text-end" id="footerStockConteo">0</td>
                                <td class="text-end" id="footerDiferencial">0</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    @*<script src="~/Content/matdash/libs/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/Content/matdash/libs/sweetalert2/dist/sweetalert2.min.js"></script>*@
    <!--<script src="~/Content/matdash/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>-->
    @*<script src="~/Content/matdash/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/Content/matdash/js/datatable/datatable-api.init.js"></script>
    <script src="~/Content/matdash/libs/select2/dist/js/select2.min.js"></script>
    <script src="~/Content/matdash/libs/select2/dist/js/select2.full.min.js"></script>
    <script src="~/Content/matdash/js/forms/select2.init.js"></script>*@

    <script nonce="@nonce">
        let tblReportePorConteo;
        let inventarioSeleccionado = {
            codigo: '',
            nombre: '',
            nroConteo: 1
        };

        $(document).ready(function () {
            inicializarComponentes();
            inicializarEventos();
        });

        function inicializarComponentes() {
            $('#cbxInventariosCerrados').select2({
                theme: 'bootstrap-5',
                width: '100%',
                placeholder: '-- Seleccione un inventario --',
                allowClear: false,
                dropdownParent: $('#cbxInventariosCerrados').parent(), // O el contenedor específico
                language: {
                    noResults: function () {
                        return "No se encontraron resultados";
                    },
                    searching: function () {
                        return "Buscando...";
                    }
                }
            });        }

        function inicializarEventos() {
            // Cuando cambia el inventario
            $('#cbxInventariosCerrados').on('change', function () {
                let selectedValue = $(this).val();
                let selectedText = $('#cbxInventariosCerrados option:selected').text();

                if (selectedValue && selectedValue !== '-1' && selectedValue !== '') {
                    inventarioSeleccionado.codigo = selectedValue;
                    inventarioSeleccionado.nombre = selectedText;
                    inventarioSeleccionado.nroConteo = 1; // Por defecto conteo 1
                    $('#cbxConteoSelector').val('1'); // Resetear al conteo 1
                    cargarDatosInventario();
                } else {
                    $('#seccionReporte').addClass('d-none');
                }
            });

            // Cuando cambia el conteo seleccionado
            $('#cbxConteoSelector').on('change', function () {
                let nroConteo = parseInt($(this).val());

                if (nroConteo && inventarioSeleccionado.codigo) {
                    inventarioSeleccionado.nroConteo = nroConteo;
                    CargarTablaPorConteo(inventarioSeleccionado.codigo, nroConteo);
                }
            });

            $('#btnExportarExcel').click(function () {
                exportarExcel();
            });
        }

        function CargarTablaPorConteo(codInventario, nroConteo) {
    // ⭐ VALIDAR PRIMERO con una llamada Ajax rápida
    $.ajax({
        url: "@Url.Action("ObtenerDatosReportePorConteo", "ReportePrincipal")",
        type: "POST",
        data: {
            codInventario: codInventario,
            nroConteo: nroConteo,
            draw: 1,
            start: 0,
            length: 1  // Solo traemos 1 registro para validar
        },
        success: function(response) {
            // ⭐ Si hay error o no hay datos, mostrar mensaje y SALIR
            if (response.error || response.recordsTotal === 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Conteo no disponible',
                    text: response.error || `El conteo #${nroConteo} no existe o no está cerrado`
                });
                return; // ⭐ NO cargar DataTable
            }

            // ⭐ Si hay datos, ENTONCES cargar DataTable
            InicializarDataTable(codInventario, nroConteo);
        },
        error: function() {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'No se pudo verificar el conteo'
            });
        }
    });
}

// ⭐ Función separada para inicializar el DataTable
function InicializarDataTable(codInventario, nroConteo) {
    if (typeof tblReportePorConteo !== 'undefined') {
        tblReportePorConteo.destroy();
    }

    tblReportePorConteo = $('#tblReportePorConteo').DataTable({
        "serverSide": true,
        "ajax": {
            "url": "@Url.Action("ObtenerDatosReportePorConteo", "ReportePrincipal")",
            "type": "POST",
            "datatype": "json",
            "data": function (d) {
                d.codInventario = codInventario;
                d.nroConteo = nroConteo;
                toggle_Loadingtb('tbLoading', true);
            },
            "complete": function (response) {
                toggle_Loadingtb('tbLoading', false);

                if (response.responseJSON) {
                    if (response.responseJSON.listFooter && response.responseJSON.listFooter.length > 0) {
                        CargarFooterReporte(response.responseJSON.listFooter);
                    }

                    if (response.responseJSON.infoInventario && response.responseJSON.infoInventario.length >= 8) {
                        let info = response.responseJSON.infoInventario;
                        $('#txtResumenNombreAlmacen').text(info[0] || '-');
                        $('#txtResumenConteoActual').text(info[6] || '-');
                        $('#txtResumenUltimoConteo').text(info[7] || '-');

                        let estado = info[5] || '-';
                        $('#badgeEstadoConteo').text(estado);
                        $('#badgeEstadoConteo').removeClass('bg-success-subtle text-success bg-warning-subtle text-warning');
                        if (estado === 'CERRADO') {
                            $('#badgeEstadoConteo').addClass('bg-success-subtle text-success');
                        } else {
                            $('#badgeEstadoConteo').addClass('bg-warning-subtle text-warning');
                        }
                    }
                }
            },
            "error": function(xhr, error, thrown) {
                toggle_Loadingtb('tbLoading', false);
                Swal.fire({
                    icon: 'error',
                    title: 'Error al cargar datos',
                    text: 'Ocurrió un error al cargar la información'
                });
            }
        },
        "columns": [
            { "data": "Cod_Producto", "title": "CÓDIGO" },
            { "data": "Dsc_Producto", "title": "PRODUCTO" },
            { "data": "Cod_ubicacion", "title": "UBICACIÓN" },
            { "data": "Lote_Producto", "title": "LOTE" },
           /* { "data": "Serie_Producto", "title": "SERIE" },*/
            {
                "data": "Stock_inicial",
                "title": "STOCK INICIAL",
                "className": "text-end",
                "render": function (data) {
                    return data != null ? Math.round(parseFloat(data)).toString() : '0';
                }
            },
            {
                "data": "Ultimo_Conteo_Finalizado",
                "title": "CONTEO #",
                "className": "text-center",
                "render": function (data) {
                    return '<span class="badge bg-primary-subtle text-primary">Conteo ' + (data || '0') + '</span>';
                }
            },
            {
                "data": "Stock_Ultimo_Conteo",
                "title": "STOCK CONTEO",
                "className": "text-end",
                "render": function (data) {
                    return data != null ? Math.round(parseFloat(data)).toString() : '0';
                }
            },
            {
                "data": "Stock_Diferencial",
                "title": "DIFERENCIAL",
                "className": "text-end",
                "render": function (data) {
                    if (data == null) return '0';
                    let value = Math.round(parseFloat(data));
                    let clase = value > 0 ? 'text-success fw-bold' : value < 0 ? 'text-danger fw-bold' : '';
                    return '<span class="' + clase + '">' + value + '</span>';
                }
            },
            { "data": "Cod_Usuario_Registro", "title": "USUARIO" }
        ],
        "paging": true,
        "pageLength": 10,
        "searching": false,
        "lengthChange": true,
        "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
        "responsive": false,
        "language": españolTbl
    });
}

