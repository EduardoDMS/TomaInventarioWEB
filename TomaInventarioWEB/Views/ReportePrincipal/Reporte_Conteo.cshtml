@{
    ViewBag.Title = "Reporte Conteo";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string nonce = (string)HttpContext.Current.Items["ScriptNonce"];
}
@*<link href="~/Content/matdash/css/fonts.css" rel="stylesheet" />
    <link href="~/Content/matdash/css/styles.css" rel="stylesheet" />
    <link href="~/Content/matdash/libs/sweetalert2/dist/sweetalert2.min.css" rel="stylesheet">
    <link href="~/Content/matdash/libs/datatables.net-bs5/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link href="~/Content/matdash/libs/select2/dist/css/select2.min.css" rel="stylesheet">*@


<!-- Sección Seleccionar Almacen e inventario -->
<div class="card text-bg-primary text-white mb-3">
    <div class="card-body p-3">
        <div class="d-flex align-items-center justify-content-center">
            <h2 class="fs-8 fw-bolder text-white mb-0">Reporte por Conteo</h2>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row">
            <!-- ALMACEN -->
            <div class="col-md-6">
                <h5 class="card-title mb-3 fw-semibold">
                    <i class="ti ti-building-warehouse me-2"></i>
                    Seleccionar un almacen
                </h5>
                <div>
                    <div class="">
                        <select class="form-select" id="cbxAlmacenes">
                            @foreach (var item in ViewBag.ListaAlmacenes)
                            {
                                <option value="@item.vchValue">@item.vchdesc</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- INVENTARIO -->
            <div class="col-md-6">
                <h5 class="card-title mb-3 fw-semibold">
                    <i class="ti ti-clipboard-check me-2"></i>
                    Seleccionar un inventario
                </h5>

                <div>
                    <div>
                        <select class="form-select" id="cbxInventariosPorAlmacen">
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Reporte por Conteo -->
<div id="seccionReporte" class="row d-none">
    <div class="col-12">
        <div class="card">
            <!-- Titulo y subtitulo -->
            <div class="card-header pb-1">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <span class="badge bg-primary-subtle text-primary">Solo se muestran productos con diferencias del último conteo</span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-success" id="btnExportarExcel">
                            <i class="ti ti-file-download me-1"></i> Exportar a Excel
                        </button>
                    </div>
                </div>
            </div>


            <div class="card-body">
                <!-- Información del Inventario -->
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-semibold mb-0">Información del Inventario</h6>
                </div>

                <!-- KPIS: Almacen, Código de inventario, Estado del conteo, Conteo actual, Productos registrados, Productos fuera del inventario, Usuarios participantes, Duracion aprox del conteo -->
                <div class="row mb-4">
                    <div class="col-md-3 d-flex flex-row gap-6 align-items-center">
                        <div class="round-40 rounded-circle text-white d-flex align-items-center justify-content-center text-bg-secondary">
                            <i class="ti ti-building-warehouse fs-6"></i>
                        </div>
                        <div class="align-self-center">
                            <h4 id="txtAlmacen" class="card-title mb-1"></h4>
                            <p class="card-subtitle">Almacen</p>
                        </div>
                    </div>

                    <div class="col-md-3 d-flex flex-row gap-6 align-items-center">
                        <div class="round-40 rounded-circle text-white d-flex align-items-center justify-content-center text-bg-primary">
                            <i class="ti ti-barcode fs-6 "></i>
                        </div>
                        <div class="align-self-center">
                            <h4 id="txtCodigoInventario" class="card-title mb-1"></h4>
                            <p class="card-subtitle">Código de inventario</p>
                        </div>
                    </div>

                    <div class="col-md-3 d-flex flex-row gap-6 align-items-center">
                        <div id="estadoIcono" class="round-40 rounded-circle text-white d-flex align-items-center justify-content-center text-bg-warning">
                            <i class="ti ti-lock-open fs-6"></i>
                        </div>
                        <div class="align-self-center">
                            <h4 id="txtEstadoConteo" class="card-title mb-1"></h4>
                            <p class="card-subtitle">Estado del conteo</p>
                        </div>
                    </div>

                    <div class="col-md-3 d-flex flex-row gap-6 align-items-center">
                        <div class="round-40 rounded-circle text-white d-flex align-items-center justify-content-center text-bg-info">
                            <i class="ti ti-history fs-6"></i>
                        </div>
                        <div class="align-self-center">
                            <h4 id="txtConteoActual" class="card-title mb-1"></h4>
                            <p class="card-subtitle">Conteo actual</p>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-3 d-flex flex-row gap-6 align-items-center">
                        <div class="round-40 rounded-circle text-white d-flex align-items-center justify-content-center text-bg-success">
                            <i class="ti ti-circle-check fs-6"></i>
                        </div>
                        <div class="align-self-center">
                            <h4 id="txtProductosRegistrados" class="card-title mb-1"></h4>
                            <p class="card-subtitle">Productos registrados</p>
                        </div>
                    </div>

                    <div class="col-md-3 d-flex flex-row gap-6 align-items-center">
                        <div class="round-40 rounded-circle text-white d-flex align-items-center justify-content-center text-bg-danger">
                            <i class="ti ti-alert-triangle fs-6"></i>
                        </div>
                        <div class="align-self-center">
                            <h4 id="txtProductosFueraInventario" class="card-title mb-1"></h4>
                            <p class="card-subtitle">Productos fuera inventario</p>
                        </div>
                    </div>

                    <div class="col-md-3 d-flex flex-row gap-6 align-items-center">
                        <div class="round-40 rounded-circle text-white d-flex align-items-center justify-content-center text-bg-success">
                            <i class="ti ti-users fs-6"></i>
                        </div>
                        <div class="align-self-center">
                            <h4 id="txtUsuariosParticipantes" class="card-title mb-1"></h4>
                            <p class="card-subtitle">Usuarios participantes</p>
                        </div>
                    </div>

                    <div class="col-md-3 d-flex flex-row gap-6 align-items-center">
                        <div class="round-40 rounded-circle text-white d-flex align-items-center justify-content-center text-bg-info">
                            <i class="ti ti-clock-hour-5 fs-6"></i>
                        </div>
                        <div class="align-self-center">
                            <h4 id="txtDuracionConteo" class="card-title mb-1"></h4>
                            <p class="card-subtitle">Duración del conteo</p>
                        </div>
                    </div>
                </div>


                <!-- Filtros -->
                <!-- Busqueda(Producto, Ubicacion, Lote, Usuario), Conteo seleccionado(1, 2, 3) -->
                <div class="accordion mb-4" id="accordionFiltros">
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                <h6 class="fs-4 mb-0">Filtros de búsqueda </h6>
                                @*<small class="text-muted ms-1">(Opcional)</small>*@
                            </button>
                        </h2>
                        <div id="collapseOne" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                            <div class="accordion-body row">
                                <!-- Busqueda general -->
                                <div class="col-md-4 mb-2">
                                    <label for="busquedaGeneral" class="form-label">Búsqueda general</label>
                                    <div class="input-group">
                                        <input id="busquedaGeneral" type="text" class="form-control" placeholder="Producto, Código, Ubicación, Lote, Usuario">
                                        <button id="btnLimpiarBusqueda" class="btn btn-outline-muted" type="button">
                                            <i class="ti ti-eraser fs-4"></i>
                                        </button>
                                    </div>
                                    @*<input type="text" class="form-control" id="busquedaGeneral" placeholder="Código o descripción del producto" />*@
                                </div>

                                <!-- Seleccionar conteo -->
                                <div class="col-md-4 mb-2">
                                    <label for="slcConteo" class="form-label">Conteo</label>
                                    <select id="slcConteo" class="form-select">
                                        @*<option selected>1</option>
                                <option>2</option>
                                <option>3</option>*@
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @*<hr class="my-4">*@

                <!-- Tabla -->
                <!-- Código, Producto, Ubicación Inicial, Ubicación Contada, Lote Inicial, Lote Contado, Stock Inicial, Stock Contado, Diferencia, Usuario -->

                <div class="table-responsive">
                    <table id="tblReporteInventario" class="table table-hover table-bordered  text-nowrap align-middle dataTable">
                        <thead class="table-light">
                            <tr>
                                <th class="text-center">Código</th>
                                <th class="text-center">Producto</th>
                                <th class="text-center">Ubicación Inicial</th>
                                <th class="text-center">Ubicación Contada</th>
                                <th class="text-center">Lote Inicial</th>
                                <th class="text-center">Lote Contado</th>
                                <th class="text-center">Stock Inicial</th>
                                <th class="text-center">Stock Contado</th>
                                <th class="text-center">Diferencia</th>
                                <th class="text-center">Usuario</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="6" class="fw-bolder">TOTALES</td>
                                <td class="text-end fw-bold" id="footerStockInicial">0</td>
                                <td class="text-end fw-bold" id="footerStockFinal">0</td>
                                <td class="text-end fw-bold" id="footerStockDiferencial">0</td>
                                <td colspan="1"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    @*<script src="~/Content/matdash/libs/jquery-validation/dist/jquery.validate.min.js"></script>
        <script src="~/Content/matdash/libs/sweetalert2/dist/sweetalert2.min.js"></script>*@
    <!--<script src="~/Content/matdash/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>-->
    @*<script src="~/Content/matdash/libs/datatables.net/js/jquery.dataTables.min.js"></script>
        <script src="~/Content/matdash/js/datatable/datatable-api.init.js"></script>
        <script src="~/Content/matdash/libs/select2/dist/js/select2.min.js"></script>
        <script src="~/Content/matdash/libs/select2/dist/js/select2.full.min.js"></script>
        <script src="~/Content/matdash/js/forms/select2.init.js"></script>*@

    <script nonce="@nonce">

        let tblReporteConteo;
        let inventarioSeleccionado = {
            codigo: '',
            nombre: '',
            nroConteo: 1
        };

        $(document).ready(function () {
            inicializarComponentes();
            inicializarEventos();
        });

        function inicializarComponentes() {
            // ALMACEN
            $('#cbxAlmacenes').select2({
                width: '100%',
                placeholder: 'Seleccione un almacen',
                allowClear: false,
                language: {
                    noResults: function () {
                        return "No se encontraron resultados";
                    },
                    searching: function () {
                        return "Buscando...";
                    }
                }
            });
            $('#cbxAlmacenes').on('change', function () {
                let selectedValue = $(this).val();
                let selectedText = $('#cbxAlmacenes option:selected').text();

                if (selectedValue && selectedValue !== '-1' && selectedValue !== '') {

                    $('#txtAlmacen').text(selectedValue || '-');
                    LoadcbxInventario(selectedValue);
                }
            });

            // INVENTARIO
            $('#cbxInventariosPorAlmacen').select2({
                width: '100%',
                placeholder: 'Seleccione un inventario',
                allowClear: false,
                language: {
                    noResults: function () {
                        return "No se encontraron resultados";
                    },
                    searching: function () {
                        return "Buscando...";
                    }
                }
            });
            $('#cbxInventariosPorAlmacen').on('change', function () {
                let selectedValue = $(this).val();
                let selectedText = $('#cbxInventariosPorAlmacen option:selected').text();

                if (selectedValue && selectedValue !== '-1' && selectedValue !== '') {
                    inventarioSeleccionado.codigo = selectedValue;
                    inventarioSeleccionado.nombre = selectedText;

                    $('#txtCodigoInventario').text(selectedValue || '-');
                    cargarDatosInventario();
                }
            });
        }

        function inicializarEventos() {
            $('#btnCargarInventario').click(function () {
                let selectedValue = $('#cbxInventariosCerrados').val();
                let selectedText = $('#cbxInventariosCerrados option:selected').text();

                if (!selectedValue || selectedValue === '-1' || selectedValue === '') {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Atención',
                        text: 'Debe seleccionar un inventario válido'
                    });
                    return;
                }

                inventarioSeleccionado.codigo = selectedValue;
                inventarioSeleccionado.nombre = selectedText;

                cargarDatosInventario();
            });

            $('#btnExportarExcel').click(function () {
                exportarExcel();
            });


            // Busqueda general
            let timeoutBusqueda = null;

            $('#busquedaGeneral').on('input', function () {
                if (modoFiltrado === "LOCAL") {
                    tblReporteInventario.search(this.value, false, false).draw();
                    return;
                }

                clearTimeout(timeoutBusqueda);

                timeoutBusqueda = setTimeout(() => {
                    CargarReporteInventarioConteo(inventarioSeleccionado.codigo);
                }, 400);
            })

            $('#busquedaGeneral').on('keydown', function (e) {
                if (e.key !== "Enter")
                    return;

                clearTimeout(timeoutBusqueda);

                CargarReporteInventarioConteo(inventarioSeleccionado.codigo);
            });

            // Limpiar busqueda
            $('#btnLimpiarBusqueda').on('click', function () {
                $('#busquedaGeneral').val('');
                tblReporteInventario.search('').draw();
                CargarReporteInventarioConteo(inventarioSeleccionado.codigo);
            });

            // Filtro conteo
            $('#slcConteo').on('change', function () {
                if (modoFiltrado === "SERVIDOR") {
                    CargarReporteInventarioConteo(inventarioSeleccionado.codigo);
                } else {
                    tblReporteInventario.column(5).search($(this).val() === "Todos" ? "" : $(this).val()).draw();
                }
            });
        }

        // NUEVO METODO CARGAR INVENTARIOS POR ALMACEN
        async function LoadcbxInventario(idAlmacen) {
            $("#cbxInventariosPorAlmacen").empty();
            //console.log(idAlmacen);

            const obj = {
                idAlmacen: idAlmacen
            }

            try {
                const response = await fetch("FillCbxInventariosPorAlmacen", {
                    method: 'POST',
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(obj)
                });
                //console.log(response.url);

                if (!response.ok) {
                    throw new Error(`Error HTTP: ${response.status}`);
                }

                const result = await response.json();
                //console.log(result);

                if (!result.success) {
                    console.error(result.mensaje);
                    return;
                }

                const data = result.data;

                let opcion = "";

                if (data.length === 0) {
                    opcion += "<option value='-1' disabled selected> --No se encuentran inventarios asociados al almacen --</option>";
                } else {
                    data.forEach(item => {
                        opcion += `<option value="${item.vchValue}">${item.vchdesc}</option>`;
                    });
                }

                $("#cbxInventariosPorAlmacen").html(opcion).trigger("change.select2");

                $("#cbxInventariosPorAlmacen").select2({
                    width: "100%",
                    language: "es",
                    placeholder: "--Seleccione un inventario--"
                });
            }
            catch (error) {
                console.error("Error:", error);
            }
        }

        function cargarDatosInventario() {
            //$('#txtResumenCodInventario').text(inventarioSeleccionado.codigo);
            $('#seccionResumen').removeClass('d-none');

            CargarReporteInventarioConteo(inventarioSeleccionado.codigo);
            console.log(inventarioSeleccionado.codigo);

            $('#seccionReporte').removeClass('d-none');
    }


        async function CargarReporteInventarioConteo(codInventario) {

             const obj = {
                 codInventario: codInventario,
                 nroConteo: $('#slcConteo').val() || 1,
                 busqueda: $('#busquedaGeneral').val().trim()
             };

             //console.log(obj);

             try {
                 const response = await fetch("ObtenerReporteConteo", {
                     method: 'POST',
                     headers: {
                         "Content-Type":"application/json"
                     },
                     body: JSON.stringify(obj)
                 });

                 if (!response.ok) {
                     throw new Error(`Error HTTP: ${response.status}`);
                 }

                 const result = await response.json();
                 console.log(result);

                 // UMBRAL PARA FILTROS AL SERVIDOR
                 let totalProductos = result.Entity.ProductosInventariados;
                 modoFiltrado = totalProductos > 1 ? "SERVIDOR" : "LOCAL";
                 //console.log(`¿Filtro a usar? = ${modoFiltrado}`);

                 // VERIFICAR CONTEOS DISPONIBLES
                 CargarConteosDisponibles(result.Entity.ConteosDisponibles);

                 // CARGAR KPIS INVENTARIO
                 CargarKPIs(result.Entity);

                 // CARGAR TABLA
                 CargarTabla(result.Entity.TblReporteConteo);

                 // CARGAR FOOTER
                 CargarFooterTabla(result.footerTable);

             }
             catch(error) {
                 console.error("Error:", error);
             }
        }

        function CargarKPIs(kpis) {
            $('#txtEstadoConteo').text(kpis.EstadoConteo || '0');
            CambiarIconoEstado(kpis.EstadoConteo);
            $('#txtConteoActual').text(kpis.ConteoSeleccionado || '0');
            $('#txtProductosRegistrados').text(kpis.ProductosLecturados || '0');
            $('#txtProductosFueraInventario').text(kpis.ProductosFueraInventario || '0');
            $('#txtUsuariosParticipantes').text(kpis.UsuariosParticipantes || '0');
            $('#txtDuracionConteo').text(kpis.DuracionConteo || '0');
        }

        function CargarTabla(datos) {

        if ($.fn.DataTable.isDataTable('#tblReporteInventario')) {
            $('#tblReporteInventario').DataTable().destroy();
        }

        $('#tblReporteInventario tbody').empty();

        tblReporteInventario = $('#tblReporteInventario').DataTable({

            data: datos,

            columns: [
                {
                    data: "CodProducto",
                    className: "text-center"
                },

                {
                    data: "DscProducto",
                    className: "text-center"
                },

                {
                    data: "UbicacionInicial",
                    className: "text-center"
                },

                {
                    data: "UbicacionContada",
                    className: "text-center"
                },

                {
                    data: "LoteInicial",
                    className: "text-center"
                },

                {
                    data: "LoteContado",
                    className: "text-center"
                },

                {
                    data: "StockInicial",
                    className: "text-center"
                },

                {
                    data: "StockContado",
                    className: "text-center"
                },

                {
                    data: "StockDiferencial",
                    className: "text-center"
                },

                {
                    data: "Usuario",
                    className: "text-center"
                }
            ],

            pageLength: 25,
            searching: true,
            dom: 'lrtip',
            language: españolTbl
        });

    }

        function CargarFooterTabla(datosFooter) {
            if (datosFooter && datosFooter.length >= 3) {
                $('#footerStockInicial').text(datosFooter[0]);
                $('#footerStockFinal').text(datosFooter[1]);

                let diferencial = datosFooter[2];
                let clase = diferencial < 0 ? 'text-danger fw-bold' : 'text-success fw-bold';
                $('#footerStockDiferencial').html('<span class="' + clase + '">' + diferencial + '</span>');
            }
        }

        // Icono lock
        function CambiarIconoEstado(estado) {
            //console.log(estado);
            if (estado === "ABIERTO") {
                $("#estadoIcono")
                    .removeClass()
                    .addClass("round-40 rounded-circle text-white d-flex align-items-center justify-content-center text-bg-warning");

                $("#estadoIcono i")
                    .removeClass()
                    .addClass("ti ti-lock-open fs-6");
            }
            else {
                $("#estadoIcono")
                    .removeClass()
                    .addClass("round-40 rounded-circle text-white d-flex align-items-center justify-content-center text-bg-success");

                $("#estadoIcono i")
                    .removeClass()
                    .addClass("ti ti-lock fs-6");
            }
        }

        function CargarConteosDisponibles(conteosDisponibles) {

            const $select = $('#slcConteo');
            const conteoSeleccionado = $select.val();

            $select.empty();

            for (let i = 1; i <= 3; i++) {

                const disponible = i <= conteosDisponibles;

                const option = $('<option>', {
                    value: i,
                    text: disponible
                        ? `Conteo ${i}`
                        : `Conteo ${i} (No disponible)`,
                    disabled: !disponible
                });

                $select.append(option);
            }

            if (conteoSeleccionado && Number(conteoSeleccionado) <= conteosDisponibles) {
                $select.val(conteoSeleccionado);
            } else {
                $select.val('1');
            }
        } 




        function exportarExcel() {
    if (!inventarioSeleccionado.codigo || !inventarioSeleccionado.nroConteo) {
        Swal.fire({
            icon: 'warning',
            title: 'Atención',
            text: 'Debe seleccionar un inventario primero'
        });
        return;
    }

    Swal.fire({
        title: 'Generando Excel...',
        html: 'Por favor espere',
        allowOutsideClick: false,
        allowEscapeKey: false,
        didOpen: () => {
            Swal.showLoading();
        }
    });

    let baseUrl = '@Url.Action("ExportarExcelReportePorConteo", "ReportePrincipal")';
    let params = '?codInventario=' + encodeURIComponent(inventarioSeleccionado.codigo) +
                 '&nroConteo=' + inventarioSeleccionado.nroConteo;

    window.location.href = baseUrl + params;

    setTimeout(function() {
        Swal.close();
    }, 1000);
    }

    </script>
}