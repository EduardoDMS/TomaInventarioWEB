<!-- Sección Seleccionar Inventario -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-3 fw-semibold">
                    <i class="ti ti-clipboard-check me-2"></i>
                    Seleccionar Inventario
                </h5>

                <div class="row align-items-end">
                    <div class="col-md-8">
                        <label for="cbxInventariosCerrados" class="form-label fw-semibold">Inventario para generar reporte detallado</label>
                        <select class="select2 form-control" id="cbxInventariosCerrados">
                            @foreach (var item in ViewBag.ListInventariosCerrados)
                            {
                                <option value="@item.vchValue">@item.vchdesc</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="button" class="btn btn-primary w-100" id="btnCargarInventario">
                            <i class="ti ti-check me-1"></i> Cargar Inventario
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Sección Resumen -->
