@{
    ViewBag.Title = "Reporte por Ubicación";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string nonce = (string)HttpContext.Current.Items["ScriptNonce"];
}


<!-- Sección Seleccionar Almacen e inventario -->
<div class="card text-bg-primary text-white mb-3">
    <div class="card-body p-3">
        <div class="d-flex align-items-center justify-content-center">
            <h2 class="fs-8 fw-bolder text-white mb-0">Reporte por Ubicación</h2>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row">
            <!-- ALMACEN -->
            <div class="col-md-6">
                <h5 class="card-title mb-3 fw-semibold">
                    <i class="ti ti-building-warehouse me-2"></i>
                    Seleccionar un almacen
                </h5>
                <div>
                    <div class="">
                        <select class="form-select" id="cbxAlmacenes">
                            @foreach (var item in ViewBag.ListaAlmacenes)
                            {
                                <option value="@item.vchValue">@item.vchdesc</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- INVENTARIO -->
            <div class="col-md-6">
                <h5 class="card-title mb-3 fw-semibold">
                    <i class="ti ti-clipboard-check me-2"></i>
                    Seleccionar un inventario
                </h5>

                <div>
                    <div>
                        <select class="form-select" id="cbxInventariosPorAlmacen">
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<!-- Reporte por Ubicación -->
<div id="seccionReporte" class="row d-none">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <!-- Informacion General: Almacen, Código de inventario, Estado de inventario, Conteo actual -->
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-semibold mb-0">Información del Inventario</h6>
                </div>
                <div class="row mb-5">
                    <div class="col d-flex flex-row gap-6 align-items-center">
                        <div class="round-40 rounded-circle text-white d-flex align-items-center justify-content-center text_bg_almacen">
                            <i class="ti ti-building-warehouse fs-6"></i>
                        </div>
                        <div class="align-self-center">
                            <h4 id="txtAlmacen" class="card-title mb-1"></h4>
                            <p class="card-subtitle">Almacen</p>
                        </div>
                    </div>

                    <div class="col d-flex flex-row gap-6 align-items-center">
                        <div class="round-40 rounded-circle text-white d-flex align-items-center justify-content-center text-bg-primary">
                            <i class="ti ti-barcode fs-6 "></i>
                        </div>
                        <div class="align-self-center">
                            <h4 id="txtCodigoInventario" class="card-title mb-1"></h4>
                            <p class="card-subtitle">Código de inventario</p>
                        </div>
                    </div>

                    <div class="col d-flex flex-row gap-6 align-items-center">
                        <div id="estadoIcono" class="round-40 rounded-circle text-white d-flex align-items-center justify-content-center text-bg-warning">
                            <i class="ti ti-lock-open fs-6"></i>
                        </div>
                        <div class="align-self-center">
                            <h4 id="txtEstadoInventario" class="card-title mb-1"></h4>
                            <p class="card-subtitle">Estado de inventario</p>
                        </div>
                    </div>

                    <div class="col d-flex flex-row gap-6 align-items-center">
                        <div class="round-40 rounded-circle text-white d-flex align-items-center justify-content-center text-bg-info">
                            <i class="ti ti-history fs-6"></i>
                        </div>
                        <div class="align-self-center">
                            <h4 id="txtConteoActual" class="card-title mb-1"></h4>
                            <p class="card-subtitle">Conteo actual</p>
                        </div>
                    </div>

                    <div class="col text-end">
                        <button type="button" class="btn btn-success" id="btnExportarExcel">
                            <i class="ti ti-file-download me-1"></i> Exportar a Excel
                        </button>
                    </div>
                </div>

                <!-- KPIS: Ubicaciones totales, Ubicaciones nuevas, Ubicaciones completas, Ubicaciones en progreso, Ubicaciones no iniciadas, Top 3 mayor diferencia, Top 3 menor diferencia-->
                <div class="row mb-3">
                    <div class="col-md-3">
                        <div class="card overflow-hidden">
                            <div class="d-flex flex-row">
                                <div class="p-3 bg-primary-subtle d-flex align-items-center">
                                    <h3 class="text-primary-emphasis box mb-0">
                                        <i class="ti ti-map-pins"></i>
                                    </h3>
                                </div>
                                <div class="p-3">
                                    <h3 id="txtUbicacionesTotales" class="text-primary-emphasis mb-0 fs-6"></h3>
                                    <span>Ubicaciones Totales</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    @*<div class="col">
                        <div class="card overflow-hidden">
                            <div class="d-flex flex-row">
                                <div class="p-3 bg-info-subtle d-flex align-items-center">
                                    <h3 class="text-info box mb-0">
                                        <i class="ti ti-map-pin-plus"></i>
                                    </h3>
                                </div>
                                <div class="p-3">
                                    <h3 id="txtUbicacionesNuevas" class="text-info mb-0 fs-6"></h3>
                                    <span>Ubicaciones Nuevas</span>
                                </div>
                            </div>
                        </div>
                    </div>*@

                    <div class="col-md-3">
                        <div class="card overflow-hidden">
                            <div class="d-flex flex-row">
                                <div class="p-3 bg-success-subtle d-flex align-items-center">
                                    <h3 class="text-success box mb-0">
                                        <i class="ti ti-map-pin-check"></i>
                                    </h3>
                                </div>
                                <div class="p-3">
                                    <h3 id="txtUbicacionesCompletas" class="text-success mb-0 fs-6"></h3>
                                    <span>Ubicaciones Completas</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card overflow-hidden">
                            <div class="d-flex flex-row">
                                <div class="p-3 bg-warning-subtle d-flex align-items-center">
                                    <h3 class="text-warning box mb-0">
                                        <i class="ti ti-map-pin"></i>
                                    </h3>
                                </div>
                                <div class="p-3">
                                    <h3 id="txtUbicacionesProgreso" class="text-warning mb-0 fs-6"></h3>
                                    <span>Ubicaciones en progreso</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card overflow-hidden">
                            <div class="d-flex flex-row">
                                <div class="p-3 bg-secondary-subtle d-flex align-items-center">
                                    <h3 class="text-secondary box mb-0">
                                        <i class="ti ti-map-pin-off"></i>
                                    </h3>
                                </div>
                                <div class="p-3">
                                    <h3 id="txtUbicacionesNoIniciadas" class="text-secondary mb-0 fs-6"></h3>
                                    <span>Ubicaciones no iniciadas</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card overflow-hidden">
                            <div class="d-flex flex-row">
                                <div class="p-3 bg-danger-subtle d-flex align-items-center">
                                    <h3 class="text-danger box mb-0">
                                        <i class="ti ti-chart-bar"></i>
                                    </h3>
                                </div>
                                <div class="p-3">
                                    <h3 id="txtMayorDiferencia" class="text-danger mb-0 fs-6"></h3>
                                    <span>Top 3 mayor diferencia</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card overflow-hidden">
                            <div class="d-flex flex-row">
                                <div class="p-3 bg-success-subtle d-flex align-items-center">
                                    <h3 class="text-success box mb-0">
                                        <i class="ti ti-chart-bar-off"></i>
                                    </h3>
                                </div>
                                <div class="p-3">
                                    <h3 id="txtMenorDiferencia" class="text-success mb-0 fs-6"></h3>
                                    <span>Top 3 menor diferencia</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


                <!-- Filtros -->
                <!-- Busqueda(Codigo, Ubicacion), Estado() -->
                <div class="accordion mb-4" id="accordionFiltros">
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                <h6 class="fs-4 mb-0">Filtros de búsqueda </h6>
                                @*<small class="text-muted ms-1">(Opcional)</small>*@
                            </button>
                        </h2>
                        <div id="collapseOne" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                            <div class="accordion-body row">
                                <!-- Busqueda general -->
                                <div class="col-md-4 mb-2">
                                    <label for="busquedaGeneral" class="form-label">Búsqueda general</label>
                                    <div class="input-group">
                                        <input id="busquedaGeneral" type="text" class="form-control" placeholder="Código o ubicación">
                                        <button id="btnLimpiarBusqueda" class="btn btn-outline-muted" type="button">
                                            <i class="ti ti-eraser fs-4"></i>
                                        </button>
                                    </div>
                                    @*<input type="text" class="form-control" id="busquedaGeneral" placeholder="Código o descripción del producto" />*@
                                </div>

                                <!-- Seleccionar observación -->
                                <div class="col-md-4 mb-2">
                                    <label for="slcEstado" class="form-label">Estado</label>
                                    <select id="slcEstado" class="form-select">
                                        <option selected>Todos</option>
                                        <option value="COMPLETA">Completa</option>
                                        <option value="PROCESO">En Proceso</option>
                                        <option value="NOINICIADA">No Iniciada</option>
                                        @*<option value="NUEVA">Nueva Ubicacion</option>*@
                                    </select>
                                </div>

                                <div class="col-md-4 gap-2 mb-2 d-flex align-items-center">
                                    <input class="form-check-input" type="checkbox" value="" id="in_soloDiferencias">
                                    <label class="form-check-label" for="flexCheckDefault">
                                        Mostrar Solo Diferencias
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tabla -->
                <!-- Código, Producto, Ubicación Inicial, Ubicación Contada, Lote Inicial, Lote Contado, Stock Inicial, Stock Contado, Diferencia, Observacion, Usuarios -->
                <div class="table-responsive">
                    <table id="tblReporteInventario" class="table table-hover table-bordered  text-nowrap align-middle dataTable">
                        <thead class="table-light">
                            <tr>
                                <th class="text-center">Código</th>
                                <th class="text-center">Ubicacion</th>
                                <th class="text-center">Productos Totales</th>
                                <th class="text-center">Stock Inicial</th>
                                <th class="text-center">Productos Contados</th>
                                <th class="text-center">Stock Contado</th>
                                <th class="text-center">Diferencia</th>
                                <th class="text-center">Estado</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="2" class="fw-bolder">TOTALES</td>
                                <td class="text-end fw-bold" id="footerStockTotalProductos">0</td>
                                <td class="text-end fw-bold" id="footerStockInicial">0</td>
                                <td colspan="1" class="fw-bolder"></td>
                                <td class="text-end fw-bold" id="footerStockFinal">0</td>
                                <td class="text-end fw-bold" id="footerStockDiferencial">0</td>
                                <td colspan="1"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {   
    <script nonce="@nonce">
        let modoFiltrado;
        let tblReporteInventario;
        let inventarioSeleccionado = {
            almacen: '',
            codigo: '',
        };

        $(document).ready(function () {
            inicializarComponentes();
            inicializarEventos();
        });

        function inicializarComponentes() {
            // ALMACEN
            $('#cbxAlmacenes').select2({
                width: '100%',
                placeholder: 'Seleccione un almacen',
                allowClear: false,
                language: {
                    noResults: function () {
                        return "No se encontraron resultados";
                    },
                    searching: function () {
                        return "Buscando...";
                    }
                }
         });
            $('#cbxAlmacenes').on('change', function () {
                let selectedValue = $(this).val();
                let selectedText = $('#cbxAlmacenes option:selected').text();

                if (selectedValue && selectedValue !== '-1' && selectedValue !== '') {

                    $('#txtAlmacen').text(selectedText || '-');
                    LoadcbxInventario(selectedValue);
                    inventarioSeleccionado.almacen = selectedText;
                }
            });

            // INVENTARIO
            $('#cbxInventariosPorAlmacen').select2({
                width: '100%',
                placeholder: 'Seleccione un inventario',
                allowClear: false,
                language: {
                    noResults: function () {
                        return "No se encontraron resultados";
                    },
                    searching: function () {
                        return "Buscando...";
                    }
                }
            });
            $('#cbxInventariosPorAlmacen').on('change', function () {
                let selectedValue = $(this).val();
                let selectedText = $('#cbxInventariosPorAlmacen option:selected').text();

                if (selectedValue && selectedValue !== '-1' && selectedValue !== '') {
                    inventarioSeleccionado.codigo = selectedValue;

                    $('#txtCodigoInventario').text(selectedValue || '-');

                    // Limpiar filtros
                    $('#busquedaGeneral').val('');
                    $('#slcEstado').val('Todos');
                    $('#in_soloDiferencias').prop('checked', false);

                    cargarDatosInventario();
                }
            });
        }

        function inicializarEventos() {
            $('#btnCargarInventario').click(function () {
                let selectedValue = $('#cbxInventariosCerrados').val();
                let selectedText = $('#cbxInventariosCerrados option:selected').text();

                if (!selectedValue || selectedValue === '-1' || selectedValue === '') {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Atención',
                        text: 'Debe seleccionar un inventario válido'
                    });
                    return;
                }

                inventarioSeleccionado.codigo = selectedValue;

                cargarDatosInventario();
            });

            $('#btnExportarExcel').click(function () {
                ExportarExcelUbicacion();
            });


            // Busqueda general Entity
            let timeoutBusqueda = null;

            $('#busquedaGeneral').on('input', function () {
                if (modoFiltrado === "LOCAL") {
                    tblReporteInventario.search(this.value, false, false).draw();
                    return;
                }

                clearTimeout(timeoutBusqueda);

                timeoutBusqueda = setTimeout(() => {
                    CargarReporteInventarioUbicacion(inventarioSeleccionado.codigo);
                }, 400);
            })

            $('#busquedaGeneral').on('keydown', function (e) {
                if (e.key !== "Enter")
                    return;

                clearTimeout(timeoutBusqueda);

                CargarReporteInventarioUbicacion(inventarioSeleccionado.codigo);
            });

            // Limpiar busqueda
            $('#btnLimpiarBusqueda').on('click', function () {
                $('#busquedaGeneral').val('');
                tblReporteInventario.search('').draw();
                CargarReporteInventarioUbicacion(inventarioSeleccionado.codigo);
            });

            // Filtro estado
            $('#slcEstado').on('change', function () {
                if (modoFiltrado === "SERVIDOR") {
                    CargarReporteInventarioUbicacion(inventarioSeleccionado.codigo);
                } else {
                    tblReporteInventario.column(8).search($(this).val() === "Todos" ? "" : $(this).val()).draw();
                }
                    
            });

            // Filtro diferencias
            $('#in_soloDiferencias').on('change', function () {
                     CargarReporteInventarioUbicacion(inventarioSeleccionado.codigo);
            });
        }


        // NUEVO METODO CARGAR INVENTARIOS POR ALMACEN
        async function LoadcbxInventario(idAlmacen) {
            $("#cbxInventariosPorAlmacen").empty();
            //console.log(idAlmacen);

            const obj = {
                idAlmacen: idAlmacen
            }

            try {
                const response = await fetch("FillCbxInventariosPorAlmacen", {
                    method: 'POST',
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(obj)
                });
                //console.log(response.url);

                if (!response.ok) {
                    throw new Error(`Error HTTP: ${response.status}`);
                }

                const result = await response.json();
                //console.log(result);

                if (!result.success) {
                    console.error(result.mensaje);
                    return;
                }

                const data = result.data;

                let opcion = "";

                if (data.length === 0) {
                    opcion += "<option value='-1' disabled selected> --No se encuentran inventarios asociados al almacen --</option>";
                } else {
                    data.forEach(item => {
                        opcion += `<option value="${item.vchValue}">${item.vchdesc}</option>`;
                    });
                }

                $("#cbxInventariosPorAlmacen").html(opcion).trigger("change.select2");

                $("#cbxInventariosPorAlmacen").select2({
                    width: "100%",
                    language: "es",
                    placeholder: "--Seleccione un inventario--"
                });
            }
            catch (error) {
                console.error("Error:", error);
            }
        }

        function cargarDatosInventario() {
            //$('#txtResumenCodInventario').text(inventarioSeleccionado.codigo);
            $('#seccionResumen').removeClass('d-none');

            //console.log(inventarioSeleccionado.codigo);
            CargarReporteInventarioUbicacion(inventarioSeleccionado.codigo);        

            $('#seccionReporte').removeClass('d-none');
        }


        // NUEVO METODO CARGAR REPORTE UBICACION
        async function CargarReporteInventarioUbicacion(codInventario) {

            const obj = {
                codInventario: codInventario,
                busqueda: $('#busquedaGeneral').val().trim(),
                estado : $('#slcEstado').val(),
                diferencias : $('#in_soloDiferencias').is(':checked') ? 1 : 0,
            };

            //console.log(obj);

            try {
                const response = await fetch("ObtenerReporteUbicacion", {
                    method: 'POST',
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(obj)
                });

                if (!response.ok) {
                    throw new Error(`Error HTTP: ${response.status}`);
                }

                const result = await response.json();
                //console.log(result);

                // UMBRAL PARA FILTROS AL SERVIDOR
                let totalUbicaciones = result.Entity.Ubicaciones_Totales;
                modoFiltrado = totalUbicaciones > 0 ? "SERVIDOR" : "LOCAL";
                //console.log(`¿Filtro a usar? = ${modoFiltrado}`);

                // CARGAR KPIS ubicacion
                CargarKPIs(result.Entity);

                // CARGAR TABLA
                CargarTabla(result.Entity.TblReporteUbicacion);

                // CARGAR FOOTER
                CargarFooterTabla(result.footerTable);
            }
            catch (error) {
                console.error("Error:", error);
            }
        }

        function CargarKPIs(kpis) {
            $('#txtEstadoInventario').text(kpis.Estado_Inventario || '0');
            CambiarIconoEstado(kpis.Estado_Inventario);
            $('#txtConteoActual').text(kpis.Conteo_Actual || '0');
            $('#txtUbicacionesTotales').text(kpis.Ubicaciones_Totales || '0');
            $('#txtUbicacionesNuevas').text(kpis.Ubicaciones_Nuevas || '0');
            $('#txtUbicacionesCompletas').text(kpis.Ubicaciones_Completas || '0');
            $('#txtUbicacionesProgreso').text(kpis.Ubicaciones_En_Proceso || '0');
            $('#txtUbicacionesNoIniciadas').text(kpis.Ubicaciones_No_Iniciadas || '0');
            $('#txtMayorDiferencia').text(kpis.Top3_Mayor_Diferencia || '-');
            $('#txtMenorDiferencia').text(kpis.Top3_Menor_Diferencia || '-');
        }

        function CargarTabla(datos) {

            if ($.fn.DataTable.isDataTable('#tblReporteInventario')) {
                $('#tblReporteInventario').DataTable().destroy();
            }

            $('#tblReporteInventario tbody').empty();

            tblReporteInventario = $('#tblReporteInventario').DataTable({

                data: datos,

                columns: [
                    {
                        data: "Cod_Ubicacion",
                        /*className: "text-center"*/
                    },

                    {
                        data: "Descripcion_Ubicacion",
                        /*className: "text-center"*/
                    },

                    {
                        data: "Productos_Totales",
                        className: "text-center"
                    },

                    {
                        data: "Stock_Inicial",
                        className: "text-center"
                    },

                    {
                        data: "Productos_Contados",
                        className: "text-center"
                    },

                    {
                        data: "Stock_Contado",
                        className: "text-center"
                    },

                    {
                        data: "Diferencia",
                        className: "text-center"
                    },

                    {
                        data: "Estado",
                        className: "text-center"
                    }
                ],

                columnDefs: [
                    {
                        targets: '_all',
                        render: function (data) {
                            return data == null || data === "" ? "-" : data;
                        }
                    }
                ],

                pageLength: 25,
                searching: true,
                dom: 'lrtip',
                language: españolTbl
            });

        }

        function CargarFooterTabla(datosFooter) {
            //console.log(datosFooter);
            if (datosFooter && datosFooter.length >= 3) {
                $('#footerStockTotalProductos').text(datosFooter[0]);
                $('#footerStockInicial').text(datosFooter[1]);
                $('#footerStockFinal').text(datosFooter[2]);

                let diferencial = datosFooter[3];
                let clase = diferencial < 0 ? 'text-danger fw-bold' : 'text-success fw-bold';
                $('#footerStockDiferencial').html('<span class="' + clase + '">' + diferencial + '</span>');
            }
        }

        function CambiarIconoEstado(estado) {
            //console.log(estado);
            if (estado === "ABIERTO") {
                $("#estadoIcono")
                    .removeClass()
                    .addClass("round-40 rounded-circle text-white d-flex align-items-center justify-content-center text-bg-warning");

                $("#estadoIcono i")
                    .removeClass()
                    .addClass("ti ti-lock-open fs-6");
            }
            else {
                $("#estadoIcono")
                    .removeClass()
                    .addClass("round-40 rounded-circle text-white d-flex align-items-center justify-content-center text-bg-success");

                $("#estadoIcono i")
                    .removeClass()
                    .addClass("ti ti-lock fs-6");
            }
        }

        // Descargar reporte en excel
        async function ExportarExcelUbicacion() {

            if (!inventarioSeleccionado.codigo) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Atención',
                    text: 'Debe seleccionar un inventario primero'
                });
                return;
            }

            const obj = {
                almacen: inventarioSeleccionado.almacen,
                codInventario: inventarioSeleccionado.codigo,
                busqueda: $('#busquedaGeneral').val().trim(),
                estado: $('#slcEstado').val(),
                diferencias: $('#in_soloDiferencias').is(':checked') ? 1 : 0,
            };

            Swal.fire({
                title: 'Generando Excel...',
                html: 'Por favor espere',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            try {

                const response = await fetch(
                    '@Url.Action("ExportarExcelUbicacion", "ReportePrincipal")',
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(obj)
                    }
                );

                if (!response.ok) {
                    throw new Error('No se pudo generar el archivo Excel.');
                }

                // Obtener archivo
                const blob = await response.blob();

                // Crear URL temporal
                const url = window.URL.createObjectURL(blob);

                // Crear enlace de descarga
                const a = document.createElement('a');
                a.href = url;
                a.download = `Reporte_Ubicacion_${obj.codInventario}.xlsx`;

                document.body.appendChild(a);
                a.click();

                // Limpiar
                a.remove();
                window.URL.revokeObjectURL(url);

                Swal.close();

            } catch (error) {

                console.error(error);

                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: error.message || 'Ocurrió un error al generar el Excel.'
                });
            }
        }

    </script>
}