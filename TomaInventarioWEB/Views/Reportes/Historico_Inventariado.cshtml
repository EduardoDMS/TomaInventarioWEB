    @*<script src="~/Content/matdash/libs/select2/dist/js/select2.full.min.js"></script>
        <script src="~/Content/matdash/libs/select2/dist/js/select2.min.js"></script>
        <script src="~/Content/matdash/js/forms/select2.init.js"></script>


        <script src="../assets/libs/select2/dist/js/select2.full.min.js"></script>
        <script src="../assets/libs/select2/dist/js/select2.min.js"></script>
        <script src="../assets/js/forms/select2.init.js"></script>*@


    <script nonce="@nonce">
        //$(document).ready(function () {
        //    toggle_Loadingtb('tbLoading', false);
        //});
        LoadCbxInventario();
        var _url = '';
        var filtro = new Object();


        document.getElementById("exportDetalle").onclick = function () {
            _url = '@Url.Content("~/")Reportes/Tabla_DET_LEC_Excel/'
            filtro.cod_Inventario = $('#datosDetallado').attr('codInv');
            filtro.NConteo = $('#datosDetallado').attr('NConteo');
            var titulo = 'Detalle de Inventario ' + 'Conteo - ' + filtro.NConteo

            getExcel(_url, filtro,titulo,1);
        };

        document.getElementById("exportLectura").onclick = function () {
            _url = '@Url.Content("~/")Reportes/Tabla_DET_LEC_Excel/';
            filtro.cod_Inventario = $('#datosLecturas').attr('codInv');
            filtro.NConteo = $('#datosLecturas').attr('NConteo');
            var titulo = 'Lecturas del inventario  ' + 'Conteo - ' + filtro.NConteo

            getExcel(_url, filtro,titulo,2);
        };

        function getExcel(_url,filtro,titulo,tipo) {
            $('#ConfirmarExport').prop("disabled", true);
            $('#exportLectura').prop("disabled", true);
            //toggle_Loadingtb('tbLoading', true);


            var _xhr = new XMLHttpRequest();
            _xhr.open('GET', _url + '?cod_Inventario=' + filtro.cod_Inventario + '&NConteo=' + filtro.NConteo
                + '&titulo=' + titulo + '&tipo=' + tipo
                + '&Almacen=' + $('#txtAlmacen_det').val(), true);
            _xhr.responseType = 'blob'; // Indicar que esperamos una respuesta binaria
            // Cuando la solicitud esté completada
            _xhr.onload = function () {
                // Crear un objeto Blob con la respuesta
                var blob = _xhr.response;

                // Crear un enlace (link) en el DOM
                var downloadLink2 = document.createElement('a');
                downloadLink2.href = window.URL.createObjectURL(blob);

                /*var titulo = '' + $('#lblInventario').text() + '- Conteo' + SlcConteo + '.xlsx';*/

                var _name = titulo
                downloadLink2.download = _name + '.xlsx';

                // Hacer click en el enlace para descargar el archivo
                document.body.appendChild(downloadLink2);
                downloadLink2.click();

                afterDownload()

            }
            // Enviar la solicitud
            _xhr.send();

        }
        function afterDownload() {
            $('#exportDetalle').prop("disabled", false);
            $('#exportLectura').prop("disabled", false);

            // Ocultar el indicador de carga
            //toggle_Loadingtb('tbLoading', false);
        }

        function CreateExcel(jsonData, titulo,tipo) {
            var data = JSON.parse(jsonData);
            ////Console.log(data);
            var columnasSeleccionadas;
            if (tipo == 1) {
                columnasSeleccionadas = ['COD_UBICACION', 'DSC_UBICACION', 'COD_PRODUCTO', 'DSC_PRODUCTO', 'LOTE_PRODUCTO', 'STOCK_INICIAL'];
            } else {
                columnasSeleccionadas = ['FCH_REGISTRO_TERMINAL', 'COD_PRODUCTO', 'DSC_PRODUCTO', 'LOTE_PRODUCTO', 'SERIE_PRODUCTO', 'STOCK_INVENTARIADO', 'COD_USUARIO_REGISTRO', 'ID_TERMINAL', 'DSC_UBICACION'];
            }



            var dataFiltrada = data.map(item => {
                var rowData = {};
                columnasSeleccionadas.forEach(columna => {
                    rowData[columna] = item[columna] || '';
                });
                return rowData;
            });

            var workbook = new ExcelJS.Workbook();
            var worksheet = workbook.addWorksheet('Hoja1');
            if (dataFiltrada.length > 0) {
                //var headers = Object.keys(data[0]);
                var headers = columnasSeleccionadas;
                worksheet.addRow(headers);
                dataFiltrada.forEach(item => {
                    var rowData = [];
                    headers.forEach(header => {
                        rowData.push(item[header] || '');
                    });
                    worksheet.addRow(rowData);
                });
                var IndexCol = 0;
                worksheet.columns.forEach((column) => {
                    var maxLength = 0;
                    column.eachCell({ includeEmpty: true }, (cell) => {
                        var columnLength = cell.value ? cell.value.toString().length : 10;
                        maxLength = Math.max(maxLength, columnLength);
                    });
                    column.width = maxLength < 10 ? 10 : maxLength + 2;
                    IndexCol = IndexCol + 1;
                    if (IndexCol >= 5 && IndexCol % 2 == 0) { GreenCol = false; } else { GreenCol = true; }
                });
                var IndexRow = 0;
                worksheet.eachRow({ includeEmpty: true }, (row) => {
                    row.eachCell({ includeEmpty: true }, (cell) => {
                        cell.border = {
                            top: { style: 'thin' },
                            left: { style: 'thin' },
                            bottom: { style: 'thin' },
                            right: { style: 'thin' }
                        };
                    });
                    if (IndexRow == 0) {
                        row.fill = {
                            type: 'pattern',
                            pattern: 'solid',
                            fgColor: {
                                argb: 'FFFFFF'
                            }
                        }
                    }
                    IndexRow = IndexRow + 1;
                });
                workbook.xlsx.writeBuffer().then((buffer) => {
                    var blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
                    var url = URL.createObjectURL(blob);
                    var a = document.createElement('a');
                    a.href = url;
                    a.download = ''+ titulo + '.xlsx';
                    document.body.appendChild(a);
                    a.click();

                    URL.revokeObjectURL(url);
                });
            }
        }


        //select 2
        $(document).ready(function () {
            $('#cbxInventarioP').select2({
                theme: 'bootstrap-5',
                width: '100%',
                //placeholder: '-- Seleccione un almacén --',
                //allowClear: true,
                //language: {
                //    noResults: function () {
                //        return "No se encontraron resultados";
                //    },
                //    searching: function () {
                //        return "Buscando...";
                //    }
                //}
            });

           
        });

    </script>
}