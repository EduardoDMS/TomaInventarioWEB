<!-- Historial de un alamcen -->
<div class="d-none" id="GestorPrincipal">

    <div class="card border-0 shadow-sm mb-2">
        <!-- Header Principal: Almacén -->
        <div class="card-header bg-primary py-3">
            <div class="d-sm-flex align-items-center justify-content-between">
                <h4 class="mb-0 text-white">
                    <i class="fas fa-warehouse me-2"></i>
                    <span id="lblAlmacen" class="fw-bold">CodAlmacen</span>
                </h4>
                @*<span class="badge bg-white text-primary px-3 py-2 fs-6">
                    <i class="fas fa-check-circle me-1"></i>Seleccionado
                </span>*@
            </div>
        </div>

        <div class="card-body p-3">
            <!-- Sección: Filtros (cuadro con borde) -->
            <div class="border rounded p-3 mb-3">
                <h6 class="mb-3 fw-semibold text-primary">
                    <i class="fas fa-filter me-2"></i>Filtros de Búsqueda
                </h6>

                <div class="row mb-3">
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="chkFiltrodtm">
                            <label class="form-check-label fw-semibold" for="chkFiltrodtm">
                                <i class="fas fa-calendar-alt me-1 text-primary"></i>Activar Filtro por Fechas
                            </label>
                        </div>
                    </div>
                </div>

                <div class="row g-3 align-items-end">
                    <div class="col-md-3 col-lg-3">
                        <label for="dtmIni" class="form-label fw-semibold mb-1">Fecha Inicio</label>
                        <input type="date" class="form-control" id="dtmIni" disabled />
                    </div>
                    <div class="col-md-3 col-lg-3">
                        <label for="dtmFin" class="form-label fw-semibold mb-1">Fecha Fin</label>
                        <input type="date" class="form-control" id="dtmFin" disabled />
                    </div>
                    <div class="col-md-3 col-lg-3 col-xl-2">
                        <button class="btn btn-primary w-100" id="btnBuscar">
                            <i class="fas fa-search me-2"></i>Buscar
                        </button>
                    </div>
                    <div class="col-md-3 col-lg-3 col-xl-2">
                        <button id="btn_limpiar" class="btn btn-secondary w-100">
                            <i class="ti ti-eraser me-2"></i>Limpiar
                        </button>
                    </div>
                </div>
            </div>

            <!-- Sección: Resultados (cuadro con borde) -->
            <div class="border rounded p-3">
                <h6 class="mb-3 fw-semibold text-primary">
                    <i class="fas fa-table me-2"></i>Resultados del Histórico
                </h6>

                <div class="row g-3 mb-3">
                    <div class="col-lg-6 col-xl-6">
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <button class="btn btn-outline-primary" id="btnDetalle">
                                <i class="ti ti-list-details me-2"></i>Ver Detalle
                            </button>
                            <button class="btn btn-outline-info" id="btnLecturas">
                                <i class="ti ti-scan me-2"></i>Ver Lecturas
                            </button>
                        </div>

                        <div class="alert alert-warning mb-3 py-2" role="alert">
                            <div class="d-flex align-items-center">
                                <i class="ti ti-hand-click fs-5 me-2 flex-shrink-0"></i>
                                <div class="flex-grow-1">
                                    <strong>Importante:</strong> Seleccione una fila de la tabla para
                                    <strong>Ver Detalle</strong> o <strong>Ver Lecturas</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 col-xl-6">
                        <div class="card bg-success-subtle border-0 h-100 mb-0">
                            <div class="card-body py-3 d-flex align-items-center">
                                <div class="round-40 rounded-circle text-white d-flex align-items-center justify-content-center bg-success flex-shrink-0">
                                    <i class="ti ti-checklist fs-6"></i>
                                </div>
                                <div class="ms-3">
                                    <h3 class="mb-0 fs-4 fw-bold text-success" id="spanCantInv">0</h3>
                                    <span class="text-muted fs-3">Total de Inventarios</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table id="tbl_Historico" class="table table-striped table-hover table-bordered w-100">
                        <thead class="table-primary">
                            <tr></tr>
                        </thead>
                        <tbody>
                            <tr></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

