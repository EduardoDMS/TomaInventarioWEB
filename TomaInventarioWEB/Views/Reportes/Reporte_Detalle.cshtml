@section scripts{
    <script src="~/Assets/JS/ReportesJS/CentralReportes.js"></script>

    <script nonce="@nonce">

        /*// VARIABLES GLOBALES CUANDOS SE SELECCIONA UNA FILA //*/
        let almacenSelect;
        let codInventarioSelect;
        let nroConteoSelect;
        let estaSelectInv;



        /*// EXPORTAR INFORME DETALLADO //*/
        const btnExportDetalleExcel = document.getElementById("exportDetalleExcel");
        let _url = '';
        let filtro = new Object();

        btnExportDetalleExcel.addEventListener("click", function () {

            if (!estaSelectInv) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Selecciona un Inventario',
                    text: 'Debe seleccionar una fila de la tabla antes de descargar el Excel.',
                });

                return;
            }

            _url = '@Url.Content("~/")Reportes/Tabla_DET_LEC_Excel/';           
            filtro.cod_Inventario = codInventarioSelect;
            filtro.NConteo = nroConteoSelect;

            let titulo = `${filtro.cod_Inventario} - Detalle de Inventario_Conteo_${filtro.NConteo}`;

            getExcel(_url, filtro, titulo, 1);
        });

        function getExcel(_url, filtro, titulo, tipo) {
            $('#ConfirmarExport').prop("disabled", true);
            $('#exportLectura').prop("disabled", true);

            var _xhr = new XMLHttpRequest();
            _xhr.open('GET', _url + '?cod_Inventario=' + filtro.cod_Inventario + '&NConteo=' + filtro.NConteo
                + '&titulo=' + titulo + '&tipo=' + tipo
                + '&Almacen=' + almacenSelect, true);
            _xhr.responseType = 'blob'; // Indicar que esperamos una respuesta binaria
            // Cuando la solicitud esté completada
            _xhr.onload = function () {
                // Crear un objeto Blob con la respuesta
                var blob = _xhr.response;

                // Crear un enlace (link) en el DOM
                var downloadLink2 = document.createElement('a');
                downloadLink2.href = window.URL.createObjectURL(blob);

                /*var titulo = '' + $('#lblInventario').text() + '- Conteo' + SlcConteo + '.xlsx';*/

                var _name = titulo
                downloadLink2.download = _name + '.xlsx';

                // Hacer click en el enlace para descargar el archivo
                document.body.appendChild(downloadLink2);
                downloadLink2.click();

                //afterDownload()

            }
            // Enviar la solicitud
            _xhr.send();
        }

