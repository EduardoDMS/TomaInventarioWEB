</main>
@section scripts{
    @*<script src="~/Content/matdash/libs/sweetalert2/dist/sweetalert2.min.js"></script>*@
    <script src="~/Assets/JS/LoginJS.js"></script>
    
    <script nonce="@nonce">

        const formLogin = document.querySelector("#loginIngreso");
        const botonLogin = document.querySelector("#btn-login");
        /*const validando = document.querySelector(".login__validando");*/

        document.getElementById("usuario").focus();

        $("#btn-login").on("click", function () {
            Autenticar();
        });

        function Autenticar() {

            // validar inputs
            if (!validarFormulario(formLogin)) {
                return;
            }

            const modelUser = {
                user: document.getElementById("usuario")?.value.trim() || "",
                pass: document.getElementById("contrasena")?.value.trim() || ""
            };

            $.ajax({
                type: "POST",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                url: "@Url.Content("~/")Seguridad/ValidarAcceso",
                data: JSON.stringify(modelUser),
                async: true,
                success: function (response) {
                    console.log(response);
                    if (response[0] == false) {
                        if (!localStorage.getItem("primeraImportacion")) {
                            localStorage.setItem("primeraImportacion", "true");
                            @*window.location.href = "@Url.Content("~/Importacion/ImportacionArchivos")";
                            localStorage.setItem("menuActivo", "ajustes");*@
                            window.location.href = "@Url.Content("~/Home/Index")";
                            localStorage.setItem("menuActivo", "inicio");
                        } else {
                            window.location.href = "@Url.Content("~/Home/Index")";
                            localStorage.setItem("menuActivo", "inicio");
                        }

                    }
                    else {
                        alertaLoginErrorBackend(response[1]);
                    }
                },
                error: function (result) {
                    alertaLoginErrorInesperado(result);
                }
            });

            //setTimeout(function () {

            //    var succ = ValidarCampos(modelUser);

            //    if (succ) {


            //    } else {
            //        ocultarValidando();
            //    }
            //}, 2000);
        }
    </script>
}
