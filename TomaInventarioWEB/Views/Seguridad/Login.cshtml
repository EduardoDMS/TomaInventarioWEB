<main class="h-100 d-flex justify-content-center align-items-center">
    <section class="col-md-9 col-xl-4 login__contenedor d-flex flex-column justify-content-between px-5">
        <!-- LOGO INICIO -->
        <div class="d-flex flex-column mb-3">
            <img class="login__logo" src="~/Assets/IMG/LogoALmacenBanner.png" alt="Logo de Toma de Inventario">
            <small class="login__eslogan">
                “Simplificamos tu inventario, maximizamos tu
                tiempo”
            </small>
        </div>
        <!-- LOGO FIN -->

        <!-- TITULO INICIO -->
        <h1 class="login__bienvenida">¡Hola, de nuevo!</h1>
        <!-- <h1 class="login__bienvenida mt-3">Te damos la bienvenida, de nuevo</h1> -->
        <!-- TITULO FIN -->

        <!-- FORMULARIO INICIO -->
        <form id="loginIngreso">
            <div class="mb-4">
                <div class="login__input">
                    @*<i class="ti ti-user icon-left"></i>*@
                    <label class="form-label fw-bold" for="usuario">Usuario</label>
                    <input id="usuario" class="form-control" type="text" placeholder="Ingrese su usuario">
                    <div class="invalid-feedback">
                        Debe ingresar un usuario.
                    </div>
                </div>
                @*<div class="text-end">
                <small>
                    No tienes una cuenta?
                    <a class="login__enlace" href="https://www.dms.com.pe/contactenos/">Registrate</a>
                </small>
            </div>*@
