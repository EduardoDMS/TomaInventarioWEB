        </div>

        <!-- Ventana de chat -->
        <div id="andronium-chat" class="card andronium-chat oculto-chat">
            <div class="card-header text-bg-primary d-flex justify-content-between px-3">
                <h6 class="card-title text-white mb-0">Andronium IA</h6>
                <span id="cerrarChat" class="andronium-cerrar">✕</span>
            </div>
            <div id="andronium-mensajes" class="card-body andronium-chat__mensajes">

            </div>
            <div class="card-footer p-1">
                <form id="androniumForm" class="d-flex gap-1">
                    <input id="andronium-input" class="form-control" placeholder="Escribe tu mensaje..." autocomplete="off" />
                    <button type="submit" id="btnEnviarMensaje" class="btn text-bg-primary">
                        <i class="ti ti-send text-white"></i>
                    </button>
                </form>
            </div>
        </div>
        <!-- FIN ANDRONIUM -->
    </main>
